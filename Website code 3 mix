   Process all images and create original exports
------------------------------------------------------- */

async function run() {
  if (processing || !items.length) return;

  const parameters = params();

  validateAnalysis(parameters);
  heightThresholds();

  invalidateModel("Processing images…");

  processing = true;
  $("run").disabled = true;

  const revision = inputRevision;
  const shared = sharedValues();

  const order = items.slice().sort((a, b) => {
    return effTime(a) - effTime(b) ||
      natural(a.file.name, b.file.name);
  });

  const files = [];
  const results = [];
  const usedNames = new Set();
  const sizes = new Set();
  const encoder = new TextEncoder();

  try {
    for (let index = 0; index < order.length; index++) {
      const item = order[index];

      $("status").className = "note";
      $("status").textContent =
        `Processing ${index + 1}/${order.length} · ${item.file.name}`;

      $("barFill").style.width =
        `${index / order.length * 100}%`;

      await new Promise(resolve => setTimeout(resolve, 0));

      const image = await loadData(item.file);

      if (revision !== inputRevision) {
        throw new Error(
          "Settings changed during processing. Process the images again."
        );
      }

      const result = analyze(image, parameters);
      const canvas = document.createElement("canvas");

      render(result, parameters, canvas);

      const blob = await new Promise(resolve => {
        canvas.toBlob(resolve, "image/png");
      });

      if (!blob) {
        throw new Error("Could not create the output PNG.");
      }

      let name = PREFIX + item.base + ".png";
      let suffix = 2;

      while (usedNames.has(name)) {
        name = PREFIX + item.base + "_" + suffix++ + ".png";
      }

      usedNames.add(name);

      files.push({
        name,
        data: new Uint8Array(await blob.arrayBuffer())
      });

      sizes.add(`${image.width}×${image.height}`);

      const env = {};

      FIELDS.forEach(field => {
        env[field.key] =
          (item.env[field.key] || "").trim() ||
          shared[field.key];
      });

      const temperature = parseFloat(env.temp);

      env.lumen = env.temp !== "" && Number.isFinite(temperature)
        ? lumenFromC(temperature)
        : "";

      env.led = env.lumen !== ""
        ? ledFromLumen(env.lumen)
        : { hex: "", r: "", g: "", b: "" };

      env.lightLevel = lightLevel(env.light);

      env.brightness = env.lightLevel !== ""
        ? Math.round(env.lightLevel * 2.55)
        : "";

      results.push({
        it: item,
        num: index + 1,
        t: effTime(item),
        res: result,
        name,
        blob,
        env
      });
    }

    const header = [
      "Image Name",
      "Image Number",
      "Colonization Rate",
      "Column",
      "Row",
      "X (px)",
      "Y (px)",
      "Time (h)",
      "Magnification",
      "Temperature (°C)",
      "Lumen Value",
      "LED Color (hex)",
      "LED Red (0-255)",
      "LED Green (0-255)",
      "LED Blue (0-255)",
      "Light Condition",
      "Light Level (0-100)",
      "LED Brightness (0-255)",
      "Sun Position",
      "Nutrients",
      "Substrate",
      "Water",
      "Oxygen",
      "Surface Structure",
      "Surface Orientation",
      "Stress",
      "Raw White Fraction (%)"
    ];

    const csvRows = [csvRow(header)];

    for (const frame of results) {
      for (let row = 0; row < parameters.rows; row++) {
        for (let column = 0; column < parameters.cols; column++) {
          const index = row * parameters.cols + column;
          const env = frame.env;

          const x =
            (frame.res.xs[column] + frame.res.xs[column + 1]) / 2;

          const y =
            (frame.res.ys[row] + frame.res.ys[row + 1]) / 2;

          csvRows.push(csvRow([
            frame.it.file.name,
            frame.num,
            frame.res.level[index],
            column + 1,
            row + 1,
            x,
            y,
            frame.t,
            shared.mag,
            env.temp,
            env.lumen,
            env.led.hex,
            env.led.r,
            env.led.g,
            env.led.b,
            env.light,
            env.lightLevel,
            env.brightness,
            env.sunPos,
            env.nutrients,
            env.substrate,
            env.water,
            env.oxygen,
            env.surfaceStructure,
            env.surfaceOrientation,
            env.stress,
            (frame.res.frac[index] * 100).toFixed(1)
          ]));
        }
      }
    }

    const gridCSV = csvRows.join("\n");
    const firstColonized = new Map();

    for (const frame of results) {
      for (let row = 0; row < parameters.rows; row++) {
        for (let column = 0; column < parameters.cols; column++) {
          const index = row * parameters.cols + column;
          const rate = frame.res.level[index];

          if (!rate) continue;

          const key = column + "," + row;
          let first = firstColonized.get(key);

          if (!first) {
            first = {
              x: (
                frame.res.xs[column] +
                frame.res.xs[column + 1]
              ) / 2,

              y: (
                frame.res.ys[row] +
                frame.res.ys[row + 1]
              ) / 2,

              num: frame.num,
              time: frame.t,
              max: rate
            };

            firstColonized.set(key, first);
          }

          first.max = Math.max(first.max, rate);
        }
      }
    }

    const firstRows = [csvRow([
      "Column",
      "Row",
      "X (px)",
      "Y (px)",
      "First Colonized In Image Number",
      "First Colonized Time (h)",
      "Highest Rate Reached",
      "Rate In Last Image"
    ])];

    const lastFrame = results[results.length - 1];

    for (let row = 0; row < parameters.rows; row++) {
      for (let column = 0; column < parameters.cols; column++) {
        const first = firstColonized.get(column + "," + row);

        if (!first) continue;

        firstRows.push(csvRow([
          column + 1,
          row + 1,
          first.x,
          first.y,
          first.num,
          first.time,
          first.max,
          lastFrame.res.level[row * parameters.cols + column]
        ]));
      }
    }

    const warning = sizes.size > 1
      ? "Images have different sizes. Use matching crops and alignment."
      : "";

    const settings = [
      "Mycelium Grid Tool settings",
      "",
      `Grid: ${parameters.cols} columns × ${parameters.rows} rows`,
      `Threshold: ${parameters.thresh}`,
      `Hyphae: ${parameters.dark ? "dark" : "light"}`,
      `Rate cut-offs (%): ${parameters.cuts.map(v => v * 100).join(", ")}`,
      `Images processed: ${results.length}`,
      `Magnification: ${shared.mag || "(not entered)"}`,
      "",
      ...FIELDS.map(field => {
        return field.label + ": " + (shared[field.key] || "(not entered)");
      }),
      "",
      "Each image may override shared conditions.",
      "Column 1 is the left edge. Row 1 is the top edge.",
      "Coordinates are cell centres in pixels.",
      "Images are ordered by their recorded time.",
      warning
    ].join("\n");

    files.push({
      name: PREFIX + "grid_points.csv",
      data: encoder.encode(gridCSV)
    });

    files.push({
      name: PREFIX + "cells_first_colonized.csv",
      data: encoder.encode(firstRows.join("\n"))
    });

    files.push({
      name: PREFIX + "settings.txt",
      data: encoder.encode(settings)
    });

    if (revision !== inputRevision) {
      throw new Error(
        "Settings changed during processing. Process the images again."
      );
    }

    acceptProcessedResults(results);

    lastResult = {
      baseFiles: files,
      csvBlob: new Blob([gridCSV], { type: "text/csv" })
    };

    $("results").replaceChildren();

    results.forEach(frame => {
      const link = document.createElement("a");
      link.href = "#";
      link.textContent = frame.name;

      link.onclick = event => {
        event.preventDefault();
        download(frame.blob, frame.name);
      };

      $("results").appendChild(link);
    });

    $("barFill").style.width = "100%";
    $("status").className = warning ? "note warn" : "note";

    $("status").textContent =
      `Done. ${results.length} image(s) processed. ` +
      `${firstColonized.size}/${parameters.cols * parameters.rows} ` +
      `cells colonized at some point. ${warning}`;

    $("dlActions").hidden = false;
  } finally {
    processing = false;
    $("run").disabled = items.length === 0;
  }
}

/* -------------------------------------------------------
   Three-level mapping
------------------------------------------------------- */

function heightThresholds() {
  const mid = Number($("heightMid").value);
  const full = Number($("heightFull").value);

  if (
    !Number.isFinite(mid) ||
    !Number.isFinite(full) ||
    mid < 0 ||
    full > 100 ||
    mid >= full
  ) {
    throw new Error(
      "Height cut-offs must satisfy 0 ≤ middle < full ≤ 100."
    );
  }

  return { mid, full };
}

function heightForCoverage(fraction, thresholds = heightThresholds()) {
  const percent = fraction * 100;

  if (percent >= thresholds.full) return 1;
  if (percent >= thresholds.mid) return 0.5;

  return 0;
}

function stopPlayback() {
  clearInterval(playbackTimer);
  playbackTimer = null;

  $("playFrames").textContent = "Play image sequence";
}

function invalidateModel(message) {
  stopPlayback();

  processedFrames = [];
  activeFrame = 0;
  lastResult = null;

  [
    "playFrames",
    "frameSelect",
    "frameRange",
    "downloadHeights",
    "downloadSequence"
  ].forEach(id => {
    $(id).disabled = true;
  });

  $("frameSelect").replaceChildren(
    new Option("Process images to load the sequence", "")
  );

  $("frameRange").max = 0;
  $("frameRange").value = 0;

  $("dlActions").hidden = true;
  $("results").replaceChildren();

  modelMessage(message);

  if (!items.length) {
    previewFrame = null;
    activeCoverage = [];
    targetHeights.fill(0);

    $("restoreFrame").disabled = true;
    updateModelTelemetry();
  }
}

function markAnalysisChanged(message) {
  inputRevision++;
  invalidateModel(message);
}

function frameFromResult(result) {
  return {
    name: result.it.file.name,
    time: result.t,
    imageNumber: result.num,
    cols: result.res.nx,
    rows: result.res.ny,
    coverage: Array.from(result.res.frac),
    rates: Array.from(result.res.level),
    env: result.env
  };
}

function acceptProcessedResults(results) {
  stopPlayback();

  processedFrames = results.map(frameFromResult);
  $("frameSelect").replaceChildren();

  processedFrames.forEach((frame, index) => {
    $("frameSelect").add(new Option(
      `${index + 1} · ${frame.name} · ${frame.time} h`,
      String(index)
    ));
  });

  [
    "playFrames",
    "frameSelect",
    "frameRange",
    "downloadHeights",
    "downloadSequence",
    "restoreFrame"
  ].forEach(id => {
    $(id).disabled = false;
  });

  $("frameRange").max = Math.max(0, processedFrames.length - 1);
  showFrame(0);
}

function previewModel(result, item) {
  if (processedFrames.length) return;

  previewFrame = {
    name: item.file.name,
    time: effTime(item),
    cols: result.nx,
    rows: result.ny,
    coverage: Array.from(result.frac),
    rates: Array.from(result.level)
  };

  applyModelFrame(previewFrame);

  modelMessage(
    `Live preview · ${item.file.name} · process all images for playback.`
  );
}

function applyModelFrame(frame) {
  if (!frame) return;

  const thresholds = heightThresholds();

  if (
    modelCols !== frame.cols ||
    modelRows !== frame.rows ||
    !targetHeights.length
  ) {
    rebuildPins(frame.cols, frame.rows);
  }

  activeCoverage = frame.coverage.slice();

  targetHeights = frame.coverage.map(fraction => {
    return heightForCoverage(fraction, thresholds);
  });

  $("restoreFrame").disabled = false;

  updateModelTelemetry();
}

function showFrame(index) {
  if (!processedFrames.length) return;

  activeFrame = Math.max(
    0,
    Math.min(processedFrames.length - 1, Number(index))
  );

  const frame = processedFrames[activeFrame];

  applyModelFrame(frame);

  $("frameSelect").value = String(activeFrame);
  $("frameRange").value = String(activeFrame);

  modelMessage(
    `Image ${activeFrame + 1}/${processedFrames.length} · ` +
    `${frame.name} · ${frame.time} h`
  );

  const itemIndex = items.findIndex(item => {
    return item.file.name === frame.name &&
      effTime(item) === frame.time;
  });

  if (itemIndex >= 0 && selected !== itemIndex) {
    selected = itemIndex;
    renderList();
    buildImagePanel();
    updatePreview();
  }
}

function travelValue() {
  const travel = Number($("travelMm").value);

  if (!Number.isFinite(travel) || travel <= 0 || travel > 100) {
    throw new Error("Travel must be greater than 0 and at most 100 mm.");
  }

  return travel;
}

function heightCSV() {
  const thresholds = heightThresholds();
  const travel = travelValue();

  const lines = [csvRow([
    "Image Name",
    "Image Number",
    "Time (h)",
    "Column",
    "Row",
    "Pin",
    "Raw White Fraction (%)",
    "Colonization Rate",
    "Height (%)",
    "Height (mm)"
  ])];

  processedFrames.forEach(frame => {
    frame.coverage.forEach((coverage, index) => {
      const height = heightForCoverage(coverage, thresholds);

      lines.push(csvRow([
        frame.name,
        frame.imageNumber,
        frame.time,
        index % frame.cols + 1,
        Math.floor(index / frame.cols) + 1,
        index + 1,
        (coverage * 100).toFixed(4),
        frame.rates[index],
        height * 100,
        height * travel
      ]));
    });
  });

  return lines.join("\n");
}

function sequenceData() {
  const thresholds = heightThresholds();

  return {
    version: 1,
    order: "row-major, top-left first",
    source: "processed images",

    heightMapping: {
      source: "raw white coverage (%)",
      middleStartsAt: thresholds.mid,
      fullStartsAt: thresholds.full,
      levels: [0, 50, 100]
    },

    travelMm: travelValue(),
    frameIntervalSeconds: Number($("frameSeconds").value),

    frames: processedFrames.map(frame => {
      return {
        ...frame,
        heightPercent: frame.coverage.map(coverage => {
          return heightForCoverage(coverage, thresholds) * 100;
        })
      };
    })
  };
}

/* -------------------------------------------------------
   Servo telemetry and Arduino matrix
------------------------------------------------------- */

function calibration() {
  const min = Number($("inputMinPulse").value);
  const max = Number($("inputMaxPulse").value);
  const low = Number($("inputMinAngle").value);
  const high = Number($("inputMaxAngle").value);

  if (
    ![min, max, low, high].every(Number.isFinite) ||
    min < 1 ||
    max > 4095 ||
    min >= max ||
    low < 0 ||
    low > 180 ||
    high < 0 ||
    high > 180
  ) {
    throw new Error(
      "Check PWM counts (1–4095, increasing) and angles (0–180°)."
    );
  }

  return { min, max, low, high };
}

function cppMatrix(name, values, type) {
  const rows = [];

  for (let row = 0; row < modelRows; row++) {
    const valuesInRow = values.slice(
      row * modelCols,
      (row + 1) * modelCols
    );

    rows.push("  {" + valuesInRow.join(", ") + "}");
  }

  return (
    `const ${type} ${name}[${modelRows}][${modelCols}] = {\n` +
    rows.join(",\n") +
    "\n};"
  );
}

function updateModelTelemetry() {
  let config;
  let travel;

  try {
    config = calibration();
    travel = travelValue();
    heightThresholds();
  } catch (error) {
    modelMessage(error.message);
    return;
  }

  const counts = [0, 0, 0];
  const angles = [];
  const percentages = [];

  targetHeights.forEach((height, index) => {
    counts[Math.round(height * 2)]++;

    const percent = height * 100;

    const angle = Math.round(
      config.low + height * (config.high - config.low)
    );

    const pwm = Math.round(
      config.min + angle / 180 * (config.max - config.min)
    );

    angles.push(angle);
    percentages.push(percent);

    const cell = $("pin-" + index);

    if (cell) {
      cell.innerHTML =
        `<small>#${index + 1}</small>${percent}%`;

      cell.style.background =
        `rgba(77,232,180,${0.04 + height * 0.27})`;

      cell.setAttribute(
        "aria-label",
        `Pin ${index + 1}, target ${percent} percent`
      );
    }

    const row = $("telem-" + index);
    const board = 0x40 + Math.floor(index / 16);

    const coverage = activeCoverage[index] === undefined
      ? "—"
      : (activeCoverage[index] * 100).toFixed(1) + "%";

    if (row) {
      row.innerHTML = `
        <td>
          #${index + 1} /
          R${Math.floor(index / modelCols) + 1}
          C${index % modelCols + 1}
        </td>
        <td>${coverage}</td>
        <td>${percent}%</td>
        <td>${height * travel} mm</td>
        <td>0x${board.toString(16)} / ${index % 16}</td>
        <td>${angle}°</td>
        <td>${pwm}</td>
      `;
    }
  });

  $("pinSummary").textContent =
    `${modelCols} × ${modelRows} · ${targetHeights.length} pins · ` +
    `0%: ${counts[0]} · 50%: ${counts[1]} · 100%: ${counts[2]}`;

  $("cppOutput").textContent =
    "// Current target frame, row-major order.\n" +
    cppMatrix("height_percent", percentages, "uint8_t") +
    "\n\n" +
    cppMatrix("servo_angles", angles, "uint8_t") +
    "\n\n" +
    "// PCA9685 frequency: 50 Hz\n" +
    `// PWM count at 0 degrees: ${config.min}\n` +
    `// PWM count at 180 degrees: ${config.max}\n` +
    "// Zero-based pin i uses board 0x40 + i / 16, channel i % 16.\n" +
    "// Calibrate your linkage before hardware use.";
}

/* -------------------------------------------------------
   Build model and pin grid
------------------------------------------------------- */

function rebuildPins(cols, rows) {
  modelCols = cols;
  modelRows = rows;

  const total = cols * rows;

  targetHeights = Array(total).fill(0);
  displayHeights = Array(total).fill(0);

  $("grid2d").style.gridTemplateColumns =
    `repeat(${cols}, minmax(40px, 1fr))`;

  $("grid2d").replaceChildren();
  $("telemetryTableBody").replaceChildren();

  for (let index = 0; index < total; index++) {
    const button = document.createElement("button");

    button.className = "pin-cell";
    button.id = "pin-" + index;

    button.onclick = () => {
      stopPlayback();

      targetHeights[index] =
        (targetHeights[index] + 0.5) % 1.5;

      modelMessage(
        `Manual target · pin ${index + 1} · ` +
        `${targetHeights[index] * 100}%`
      );

      updateModelTelemetry();
    };

    $("grid2d").appendChild(button);

    const tableRow = document.createElement("tr");
    tableRow.id = "telem-" + index;

    $("telemetryTableBody").appendChild(tableRow);
  }

  if (renderer && scene) {
    if (pinGroup) {
      scene.remove(pinGroup);

      pinGroup.traverse(object => {
        if (object.geometry) object.geometry.dispose();
        if (object.material) object.material.dispose();
      });
    }

    pinGroup = new THREE.Group();
    scene.add(pinGroup);

    pinMeshes = [];
    rods = [];

    const width = (cols - 1) * 40 + 80;
    const depth = (rows - 1) * 40 + 80;

    for (const y of [-20, 20]) {
      const plate = new THREE.Mesh(
        new THREE.BoxGeometry(width, 5, depth),
        new THREE.MeshStandardMaterial({
          color: 0x17362b,
          metalness: 0.35,
          roughness: 0.6,
          transparent: true,
          opacity: 0.55
        })
      );

      plate.position.y = y;
      pinGroup.add(plate);
    }

    for (let row = 0; row < rows; row++) {
      for (let column = 0; column < cols; column++) {
        const x = (column - (cols - 1) / 2) * 40;
        const z = (row - (rows - 1) / 2) * 40;

        const pin = new THREE.Mesh(
          new THREE.CylinderGeometry(6, 6, 80, 16),
          new THREE.MeshStandardMaterial({
            color: 0xd4ae5a,
            roughness: 0.4,
            metalness: 0.3
          })
        );

        pin.position.set(x, -14, z);

        pinGroup.add(pin);
        pinMeshes.push(pin);

        const rod = new THREE.Mesh(
          new THREE.CylinderGeometry(1.5, 1.5, 30, 8),
          new THREE.MeshStandardMaterial({
            color: 0x4de8b4
          })
        );

        rod.position.set(x, -65, z);

        pinGroup.add(rod);
        rods.push(rod);
      }
    }

    viewDistance = Math.max(width, depth) * 1.5;
    setCameraView("iso");
  }

  updateModelTelemetry();
}

function setCameraView(view) {
  fallbackView = view;

  if (!camera) return;

  if (view === "top") {
    camera.position.set(0, viewDistance * 1.4, 0.1);
  } else if (view === "side") {
    camera.position.set(viewDistance * 1.5, 45, 0);
  } else {
    camera.position.set(
      viewDistance,
      viewDistance * 0.85,
      viewDistance
    );
  }

  camera.lookAt(0, 0, 0);
}

function initModelScene() {
  if (typeof THREE === "undefined") {
    return;
  }

  const container = $("canvas3d");

  try {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x050d0b);

    camera = new THREE.PerspectiveCamera(
      45,
      1,
      0.1,
      20000
    );

    renderer = new THREE.WebGLRenderer({
      antialias: true
    });

    renderer.setPixelRatio(
      Math.min(2, window.devicePixelRatio || 1)
    );

    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.75));

    const light = new THREE.DirectionalLight(0xffffff, 0.9);
    light.position.set(200, 400, 100);

    scene.add(light);

    function resize() {
      const width = container.clientWidth;
      const height = container.clientHeight;

      renderer.setSize(width, height);

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }

    new ResizeObserver(resize).observe(container);
    resize();

    let previous = null;

    container.addEventListener("pointerdown", event => {
      previous = {
        x: event.clientX,
        y: event.clientY
      };

      container.setPointerCapture(event.pointerId);
    });

    container.addEventListener("pointerup", () => {
      previous = null;
    });

    container.addEventListener("pointercancel", () => {
      previous = null;
    });

    container.addEventListener("pointermove", event => {
      if (!previous) return;

      const dx = event.clientX - previous.x;
      const dy = event.clientY - previous.y;

      const spherical = new THREE.Spherical()
        .setFromVector3(camera.position);

      spherical.theta -= dx * 0.007;

      spherical.phi = Math.max(
        0.03,
        Math.min(
          Math.PI - 0.03,
          spherical.phi + dy * 0.007
        )
      );

      camera.position.setFromSpherical(spherical);
      camera.lookAt(0, 0, 0);

      previous = {
        x: event.clientX,
        y: event.clientY
      };
    });

    container.addEventListener("wheel", event => {
      event.preventDefault();

      const length = camera.position.length();

      const nextLength = Math.max(
        60,
        Math.min(
          12000,
          length * Math.exp(event.deltaY * 0.001)
        )
      );

      camera.position.multiplyScalar(nextLength / length);
    }, { passive: false });

  } catch (error) {
    renderer = null;
    scene = null;
    camera = null;
    container.replaceChildren();
  }
}

/* -------------------------------------------------------
   Canvas model fallback
------------------------------------------------------- */

function initFallback() {
  const container = $("canvas3d");

  container.replaceChildren();

  fallbackCanvas = document.createElement("canvas");
  container.appendChild(fallbackCanvas);

  let previousX = null;

  container.addEventListener("pointerdown", event => {
    previousX = event.clientX;
    container.setPointerCapture(event.pointerId);
  });

  container.addEventListener("pointerup", () => {
    previousX = null;
  });

  container.addEventListener("pointercancel", () => {
    previousX = null;
  });

  container.addEventListener("pointermove", event => {
    if (previousX === null) return;

    fallbackView = "iso";

    fallbackRotation +=
      (event.clientX - previousX) * 0.008;

    previousX = event.clientX;
  });

  container.addEventListener("wheel", event => {
    event.preventDefault();

    fallbackScale = Math.max(
      0.4,
      Math.min(
        3,
        fallbackScale * Math.exp(-event.deltaY * 0.001)
      )
    );
  }, { passive: false });
}

function drawFallback() {
  if (!fallbackCanvas) return;

  const width = fallbackCanvas.clientWidth;
  const height = fallbackCanvas.clientHeight;

  const dpr = Math.min(
    2,
    window.devicePixelRatio || 1
  );

  const pixelWidth = Math.round(width * dpr);
  const pixelHeight = Math.round(height * dpr);

  if (
    fallbackCanvas.width !== pixelWidth ||
    fallbackCanvas.height !== pixelHeight
  ) {
    fallbackCanvas.width = pixelWidth;
    fallbackCanvas.height = pixelHeight;
  }

  const context = fallbackCanvas.getContext("2d");

  context.setTransform(dpr, 0, 0, dpr, 0, 0);
  context.clearRect(0, 0, width, height);

  const scale = Math.min(
    width / ((modelCols + modelRows) * 0.85 + 2),
    height / ((modelCols + modelRows) * 0.45 + 3)
  ) * fallbackScale;

  const angle = Math.PI / 4 + fallbackRotation;
  const travel = Number($("travelMm").value) || 20;

  function project(x, z, y = 0) {
    const rotatedX =
      x * Math.cos(angle) - z * Math.sin(angle);

    const rotatedZ =
      x * Math.sin(angle) + z * Math.cos(angle);

    if (fallbackView === "top") {
      return [
        width / 2 + x * scale,
        height / 2 + z * scale
      ];
    }

    if (fallbackView === "side") {
      return [
        width / 2 + x * scale,
        height * 0.65 - y * scale
      ];
    }

    return [
      width / 2 + rotatedX * scale,
      height * 0.58 + rotatedZ * scale * 0.5 - y * scale
    ];
  }

  const corners = [
    [-modelCols / 2 - 0.4, -modelRows / 2 - 0.4],
    [ modelCols / 2 + 0.4, -modelRows / 2 - 0.4],
    [ modelCols / 2 + 0.4,  modelRows / 2 + 0.4],
    [-modelCols / 2 - 0.4,  modelRows / 2 + 0.4]
  ];

  context.beginPath();

  corners.forEach(([x, z], index) => {
    const position = project(x, z);

    if (index === 0) {
      context.moveTo(...position);
    } else {
      context.lineTo(...position);
    }
  });

  context.closePath();
  context.fillStyle = "#102b22";
  context.fill();

  context.strokeStyle = "#4b7966";
  context.lineWidth = 1;
  context.stroke();

  const pins = displayHeights.map((pinHeight, index) => {
    return {
      height: pinHeight,
      index,
      x: index % modelCols - (modelCols - 1) / 2,
      z: Math.floor(index / modelCols) - (modelRows - 1) / 2
    };
  });

  pins.sort((a, b) => {
    const depthA =
      a.x * Math.sin(angle) + a.z * Math.cos(angle);

    const depthB =
      b.x * Math.sin(angle) + b.z * Math.cos(angle);

    return depthA - depthB;
  });

  for (const pin of pins) {
    const base = project(pin.x, pin.z);

    const top = project(
      pin.x,
      pin.z,
      0.18 + pin.height * travel / 20
    );

    const radius = Math.max(2, scale * 0.15);

    const color = pin.height > 0.74
      ? "#d4ae5a"
      : pin.height > 0.24
        ? "#4de8b4"
        : "#6c8b7e";

    context.strokeStyle = color;
    context.lineWidth = radius * 2;

    if (fallbackView !== "top") {
      context.beginPath();
      context.moveTo(...base);
      context.lineTo(...top);
      context.stroke();
    }

    context.beginPath();

    context.ellipse(
      top[0],
      top[1],
      radius,
      fallbackView === "top" ? radius : radius * 0.5,
      0,
      0,
      Math.PI * 2
    );

    context.fillStyle = color;
    context.fill();

    if (pins.length <= 64) {
      context.fillStyle = "#e8f4ee";
      context.font = "11px monospace";
      context.textAlign = "center";

      context.fillText(
        String(pin.index + 1),
        top[0],
        top[1] - 8
      );
    }
  }

  context.fillStyle = "#9bbdae";
  context.font = "12px monospace";
  context.textAlign = "left";
  context.fillText("ROW 1 = IMAGE TOP", 14, 24);
}

/* -------------------------------------------------------
   Model animation
------------------------------------------------------- */

function animateModel(now) {
  requestAnimationFrame(animateModel);

  const dt = Math.min(
    0.1,
    Math.max(0, (now - lastAnimationTime) / 1000)
  );

  lastAnimationTime = now;

  const travel = Number($("travelMm").value) || 20;

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  displayHeights.forEach((height, index) => {
    const target = targetHeights[index];

    displayHeights[index] = reducedMotion
      ? target
      : height + (target - height) * (1 - Math.exp(-dt * 4));

    if (pinMeshes[index]) {
      pinMeshes[index].position.y =
        -14 + displayHeights[index] * travel;

      rods[index].position.y =
        pinMeshes[index].position.y - 51;
    }
  });

  if (renderer && scene && camera) {
    renderer.render(scene, camera);
  } else {
    drawFallback();
  }
}

function updateMapping() {
  try {
    const thresholds = heightThresholds();

    $("mappingNote").className = "note";

    $("mappingNote").textContent =
      `Coverage below ${thresholds.mid}% → height 0%; ` +
      `${thresholds.mid}% to below ${thresholds.full}% → height 50%; ` +
      `${thresholds.full}% and above → height 100%.`;

    if (processedFrames.length) {
      showFrame(activeFrame);
    } else if (previewFrame) {
      applyModelFrame(previewFrame);
    }

    if (lastResult) {
      $("status").textContent =
        "Height mapping updated. Downloads use current height settings.";
    }
  } catch (error) {
    $("mappingNote").className = "note warn";
    $("mappingNote").textContent = error.message;

    stopPlayback();
  }
}

/* -------------------------------------------------------
   Background drawing
------------------------------------------------------- */

function mulberry32(seed) {
  return function () {
    seed |= 0;
    seed = seed + 0x6D2B79F5 | 0;

    let value = Math.imul(seed ^ seed >>> 15, 1 | seed);

    value = value +
      Math.imul(value ^ value >>> 7, 61 | value) ^
      value;

    return ((value ^ value >>> 14) >>> 0) / 4294967296;
  };
}

function drawBackground(animate) {
  const canvas = $("bg");
  const dpr = Math.min(2, window.devicePixelRatio || 1);

  const width = window.innerWidth;
  const height = window.innerHeight;

  canvas.width = width * dpr;
  canvas.height = height * dpr;

  const context = canvas.getContext("2d");
  context.setTransform(dpr, 0, 0, dpr, 0, 0);
  context.clearRect(0, 0, width, height);

  const random = mulberry32(20261111);
  const radius = Math.max(46, Math.min(width, height) * 0.1);

  context.strokeStyle = "rgba(212,174,90,.14)";
  context.lineWidth = 1;

  for (let ring = 0; ring < 2; ring++) {
    for (let index = 0; index < 6; index++) {
      const angle = index * Math.PI / 3;

      const x =
        width * 0.93 + Math.cos(angle) * radius * ring;

      const y =
        height * 0.12 + Math.sin(angle) * radius * ring;

      context.beginPath();
      context.arc(x, y, radius, 0, Math.PI * 2);
      context.stroke();
    }
  }

  const segments = [];

  function grow(x, y, heading, steps, depth, startTime) {
    let time = startTime;

    for (let index = 0; index < steps; index++) {
      const angle = heading + (random() - 0.5) * 0.55;
      const length = 6 + random() * 6;

      const nextX = x + Math.cos(angle) * length;
      const nextY = y + Math.sin(angle) * length;

      segments.push({
        x1: x,
        y1: y,
        x2: nextX,
        y2: nextY,
        width: Math.max(0.5, 2.1 - depth * 0.45),
        time,
        end: index === steps - 1
      });

      x = nextX;
      y = nextY;
      heading = angle;
      time++;

      if (random() < 0.065 && depth < 4) {
        grow(
          x,
          y,
          angle +
            (random() < 0.5 ? -1 : 1) *
            (0.5 + random() * 0.8),
          Math.floor(steps * 0.62) + 4,
          depth + 1,
          time
        );
      }

      if (
        x < -60 ||
        x > width + 60 ||
        y < -60 ||
        y > height + 60
      ) {
        break;
      }
    }
  }

  const seeds = [
    [0, height * 0.3, 0.2],
    [0, height * 0.75, -0.3],
    [width * 0.25, height, -1.3],
    [width * 0.7, height, -1.9],
    [width, height * 0.45, 3.3],
    [width, height * 0.85, 3.6],
    [width * 0.5, 0, 1.5]
  ];

  seeds.forEach(seed => {
    grow(
      seed[0],
      seed[1],
      seed[2],
      70 + Math.floor(random() * 40),
      0,
      Math.floor(random() * 12)
    );
  });

  segments.sort((a, b) => a.time - b.time);

  function drawSegment(segment) {
    context.strokeStyle =
      `rgba(77,232,180,${0.1 + segment.width * 0.07})`;

    context.lineWidth = segment.width;
    context.lineCap = "round";

    context.beginPath();
    context.moveTo(segment.x1, segment.y1);
    context.lineTo(segment.x2, segment.y2);
    context.stroke();

    if (segment.end) {
      context.fillStyle = "rgba(212,174,90,.5)";
      context.beginPath();
      context.arc(
        segment.x2,
        segment.y2,
        1.8,
        0,
        Math.PI * 2
      );
      context.fill();
    }
  }

  drawBackground.token = (drawBackground.token || 0) + 1;
  const token = drawBackground.token;

  if (!animate) {
    segments.forEach(drawSegment);
    return;
  }

  const started = performance.now();
  const maxTime = segments[segments.length - 1].time + 1;

  let index = 0;

  function frame(now) {
    if (drawBackground.token !== token) return;

    const limit = Math.min(1, (now - started) / 7000) * maxTime;

    while (
      index < segments.length &&
      segments[index].time <= limit
    ) {
      drawSegment(segments[index]);
      index++;
    }

    if (index < segments.length) {
      requestAnimationFrame(frame);
    }
  }

  requestAnimationFrame(frame);
}

/* -------------------------------------------------------
   Event handlers
------------------------------------------------------- */

function initEvents() {
  $("pickFiles").onclick = () => $("fileInput").click();
  $("pickFolder").onclick = () => $("folderInput").click();

  $("fileInput").onchange = event => {
    addFiles(event.target.files);
    event.target.value = "";
  };

  $("folderInput").onchange = event => {
    addFiles(event.target.files);
    event.target.value = "";
  };

  const drop = $("drop");

  ["dragenter", "dragover"].forEach(name => {
    drop.addEventListener(name, event => {
      event.preventDefault();
      drop.classList.add("over");
    });
  });

  ["dragleave", "drop"].forEach(name => {
    drop.addEventListener(name, event => {
      event.preventDefault();
      drop.classList.remove("over");
    });
  });

  drop.addEventListener("drop", event => {
    addFiles(event.dataTransfer.files);
  });

  $("clearAll").onclick = () => {
    if (processing) return;

    items = [];
    selected = 0;
    previewCache = null;

    markAnalysisChanged("All images cleared.");

    renderList();
    updatePreview();
  };

  $("threshRange").oninput = () => {
    $("thresh").value = $("threshRange").value;
    updatePreview();
  };

  $("thresh").oninput = () => {
    $("threshRange").value = $("thresh").value;
    updatePreview();
  };

  [
    "cols",
    "rows",
    "mode",
    "c1",
    "c2",
    "c3",
    "c4",
    "showGrid",
    "showOn",
    "showNums"
  ].forEach(id => {
    $(id).oninput = updatePreview;
    $(id).onchange = updatePreview;
  });

  $("auto").onclick = async () => {
    if (!items.length || processing) return;

    const item = items[selected];

    try {
      const image =
        previewCache && previewCache.file === item.file
          ? previewCache.data
          : await loadData(item.file);

      if (items[selected] !== item) return;

      const threshold = otsu(image);

      $("thresh").value = threshold;
      $("threshRange").value = threshold;

      markAnalysisChanged(
        "Auto threshold updated. Process all images again."
      );

      updatePreview();
    } catch (error) {
      $("status").textContent = error.message;
    }
  };

  $("run").onclick = async () => {
    try {
      await run();
    } catch (error) {
      $("status").className = "note warn";
      $("status").textContent = error.message;
    }
  };

  $("dlCsv").onclick = () => {
    if (!lastResult) return;

    download(
      lastResult.csvBlob,
      PREFIX + "grid_points.csv"
    );
  };

  $("dlZip").onclick = () => {
    if (!lastResult) return;

    try {
      const encoder = new TextEncoder();

      const files = [
        ...lastResult.baseFiles,
        {
          name: PREFIX + "pin_heights.csv",
          data: encoder.encode(heightCSV())
        },
        {
          name: PREFIX + "pin_sequence.json",
          data: encoder.encode(
            JSON.stringify(sequenceData(), null, 2)
          )
        }
      ];

      download(
        makeZip(files),
        PREFIX + "all.zip"
      );
    } catch (error) {
      modelMessage(error.message);
    }
  };

  $("frameSelect").onchange = () => {
    stopPlayback();
    showFrame($("frameSelect").value);
  };

  $("frameRange").oninput = () => {
    stopPlayback();
    showFrame($("frameRange").value);
  };

  $("playFrames").onclick = () => {
    if (playbackTimer) {
      stopPlayback();
      return;
    }

    if (!processedFrames.length) return;

    try {
      heightThresholds();

      const seconds = Number($("frameSeconds").value);

      if (
        !Number.isFinite(seconds) ||
        seconds < 1 ||
        seconds > 60
      ) {
        throw new Error(
          "Playback interval must be between 1 and 60 seconds."
        );
      }

      $("playFrames").textContent = "Pause image sequence";

      playbackTimer = setInterval(() => {
        showFrame(
          (activeFrame + 1) % processedFrames.length
        );
      }, seconds * 1000);

    } catch (error) {
      modelMessage(error.message);
    }
  };

  $("resetPins").onclick = () => {
    stopPlayback();
    targetHeights.fill(0);
    updateModelTelemetry();

    modelMessage("All target heights set to 0%.");
  };

  $("restoreFrame").onclick = () => {
    stopPlayback();

    if (processedFrames.length) {
      showFrame(activeFrame);
    } else {
      applyModelFrame(previewFrame);
      modelMessage("Live image heights restored.");
    }
  };

  [
    ["camIso", "iso"],
    ["camTop", "top"],
    ["camSide", "side"]
  ].forEach(([id, view]) => {
    $(id).onclick = () => setCameraView(view);
  });

  ["heightMid", "heightFull"].forEach(id => {
    $(id).oninput = () => {
      stopPlayback();
      updateMapping();
    };
  });

  [
    "inputMinPulse",
    "inputMaxPulse",
    "inputMinAngle",
    "inputMaxAngle",
    "travelMm"
  ].forEach(id => {
    $(id).oninput = updateModelTelemetry;
  });

  $("frameSeconds").oninput = stopPlayback;

  $("downloadHeights").onclick = () => {
    try {
      download(
        new Blob([heightCSV()], { type: "text/csv" }),
        "pin_heights.csv"
      );
    } catch (error) {
      modelMessage(error.message);
    }
  };

  $("downloadSequence").onclick = () => {
    try {
      download(
        new Blob(
          [JSON.stringify(sequenceData(), null, 2)],
          { type: "application/json" }
        ),
        "pin_sequence.json"
      );
    } catch (error) {
      modelMessage(error.message);
    }
  };

  $("copyMatrix").onclick = async () => {
    try {
      await navigator.clipboard.writeText(
        $("cppOutput").textContent
      );

      modelMessage("Arduino target matrix copied.");
    } catch (error) {
      const range = document.createRange();
      range.selectNodeContents($("cppOutput"));

      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);

      modelMessage(
        "Matrix selected. Press Ctrl+C or Command+C to copy."
      );
    }
  };

  document.querySelectorAll("[data-demo]").forEach(button => {
    button.onclick = () => {
      stopPlayback();

      const stage = Number(button.dataset.demo);
      activeCoverage = [];

      targetHeights = targetHeights.map((_, index) => {
        const x =
          (index % modelCols + 0.5) / modelCols - 0.5;

        const y =
          (Math.floor(index / modelCols) + 0.5) /
          modelRows - 0.5;

        const distance = Math.hypot(x, y);

        const density = Math.max(
          0,
          1 - distance / (0.2 + stage * 0.3)
        );

        if (density >= 0.65) return 1;
        if (density >= 0.15) return 0.5;

        return 0;
      });

      updateModelTelemetry();

      modelMessage(
        `Illustrative demo preset T${stage} loaded.`
      );
    };
  });

  ["input", "change"].forEach(eventName => {
    document.querySelector("main").addEventListener(
      eventName,
      event => {
        if (
          event.target.closest("#modelPanel") ||
          event.target.type === "file"
        ) {
          return;
        }

        markAnalysisChanged(
          "Analysis settings or metadata changed. Process all images again."
        );
      }
    );
  });

  let resizeTimer = null;

  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);

    resizeTimer = setTimeout(() => {
      drawBackground(false);
    }, 250);
  });
}

/* -------------------------------------------------------
   Start application
------------------------------------------------------- */

function init() {
  buildFieldBlock($("sharedFields"), "sh_", true);

  $("cols").value = CONFIG.gridCols;
  $("rows").value = CONFIG.gridRows;

  CONFIG.cuts.forEach((value, index) => {
    $("c" + (index + 1)).value = value;
  });

  initModelScene();

  if (!renderer) {
    initFallback();
  }

  rebuildPins(CONFIG.gridCols, CONFIG.gridRows);
  initEvents();
  updateLevelNote();
  updateMapping();

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  drawBackground(!reducedMotion);
  requestAnimationFrame(animateModel);
}

init();
</script>
