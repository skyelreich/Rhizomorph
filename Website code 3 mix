------------------------------------------------------- */

function params() {
  return {
    cols: clampInt($("cols").value, 1, 40, CONFIG.gridCols),
    rows: clampInt($("rows").value, 1, 40, CONFIG.gridRows),
    dark: $("mode").value === "dark",
    thresh: clampInt($("thresh").value, 0, 255, 128),

    cuts: [
      Number($("c1").value) / 100,
      Number($("c2").value) / 100,
      Number($("c3").value) / 100,
      Number($("c4").value) / 100
    ],

    grid: $("showGrid").checked,
    tint: $("showOn").checked,
    nums: $("showNums").checked
  };
}

function validateAnalysis(parameters) {
  const cuts = parameters.cuts;

  const valid = cuts.every((value, index) => {
    return Number.isFinite(value) &&
      value >= 0 &&
      value <= 1 &&
      (index === 0 || value >= cuts[index - 1]);
  });

  if (!valid) {
    throw new Error(
      "Colonization cut-offs must increase from left to right within 0–100%."
    );
  }
}

function levelOf(fraction, cuts) {
  if (fraction > 0 && fraction >= cuts[3]) return 20;
  if (fraction > 0 && fraction >= cuts[2]) return 15;
  if (fraction > 0 && fraction >= cuts[1]) return 10;
  if (fraction > 0 && fraction >= cuts[0]) return 5;

  return 0;
}

function updateLevelNote() {
  const parameters = params();
  const cuts = parameters.cuts.map(value => {
    return Number((value * 100).toFixed(1));
  });

  try {
    validateAnalysis(parameters);

    $("levelNote").className = "note";
    $("levelNote").textContent =
      `Rate 0 < ${cuts[0]}% · ` +
      `Rate 5 ≥ ${cuts[0]}% · ` +
      `Rate 10 ≥ ${cuts[1]}% · ` +
      `Rate 15 ≥ ${cuts[2]}% · ` +
      `Rate 20 ≥ ${cuts[3]}%`;
  } catch (error) {
    $("levelNote").className = "note warn";
    $("levelNote").textContent = error.message;
  }
}

async function loadData(file) {
  const bitmap = await createImageBitmap(file);

  const canvas = document.createElement("canvas");
  canvas.width = bitmap.width;
  canvas.height = bitmap.height;

  const context = canvas.getContext("2d", {
    willReadFrequently: true
  });

  context.drawImage(bitmap, 0, 0);

  if (bitmap.close) {
    bitmap.close();
  }

  return context.getImageData(
    0,
    0,
    canvas.width,
    canvas.height
  );
}

function analyze(image, parameters) {
  const width = image.width;
  const height = image.height;
  const source = image.data;

  const cols = parameters.cols;
  const rows = parameters.rows;

  const output = new ImageData(width, height);
  const mask = new Uint8Array(width * height);

  for (let pixel = 0; pixel < width * height; pixel++) {
    const offset = pixel * 4;

    const luminance =
      0.299 * source[offset] +
      0.587 * source[offset + 1] +
      0.114 * source[offset + 2];

    const hypha = parameters.dark
      ? luminance < parameters.thresh
      : luminance > parameters.thresh;

    const value = hypha ? 255 : 0;

    output.data[offset] = value;
    output.data[offset + 1] = value;
    output.data[offset + 2] = value;
    output.data[offset + 3] = 255;

    mask[pixel] = hypha ? 1 : 0;
  }

  const xs = [];
  const ys = [];

  for (let column = 0; column <= cols; column++) {
    xs.push(Math.round(column * width / cols));
  }

  for (let row = 0; row <= rows; row++) {
    ys.push(Math.round(row * height / rows));
  }

  const frac = new Float32Array(cols * rows);
  const level = new Uint8Array(cols * rows);

  for (let row = 0; row < rows; row++) {
    for (let column = 0; column < cols; column++) {
      let whitePixels = 0;

      for (let y = ys[row]; y < ys[row + 1]; y++) {
        for (let x = xs[column]; x < xs[column + 1]; x++) {
          whitePixels += mask[y * width + x];
        }
      }

      const area =
        (xs[column + 1] - xs[column]) *
        (ys[row + 1] - ys[row]);

      const fraction = area ? whitePixels / area : 0;
      const index = row * cols + column;

      frac[index] = fraction;
      level[index] = levelOf(fraction, parameters.cuts);
    }
  }

  return {
    bw: output,
    w: width,
    h: height,
    nx: cols,
    ny: rows,
    xs,
    ys,
    frac,
    level
  };
}

function render(result, parameters, canvas) {
  canvas.width = result.w;
  canvas.height = result.h;

  const context = canvas.getContext("2d");
  context.putImageData(result.bw, 0, 0);

  if (parameters.tint) {
    for (let row = 0; row < result.ny; row++) {
      for (let column = 0; column < result.nx; column++) {
        const rate = result.level[row * result.nx + column];

        if (!rate) continue;

        context.fillStyle =
          `rgba(255,60,60,${rate / 20 * 0.5})`;

        context.fillRect(
          result.xs[column],
          result.ys[row],
          result.xs[column + 1] - result.xs[column],
          result.ys[row + 1] - result.ys[row]
        );
      }
    }
  }

  if (parameters.grid) {
    context.strokeStyle = "rgba(0,220,255,.7)";
    context.lineWidth = Math.max(
      1,
      Math.round(Math.min(result.w, result.h) / 600)
    );

    context.beginPath();

    for (let column = 1; column < result.nx; column++) {
      context.moveTo(result.xs[column] + 0.5, 0);
      context.lineTo(result.xs[column] + 0.5, result.h);
    }

    for (let row = 1; row < result.ny; row++) {
      context.moveTo(0, result.ys[row] + 0.5);
      context.lineTo(result.w, result.ys[row] + 0.5);
    }

    context.stroke();
  }

  const cellSize = Math.min(
    result.w / result.nx,
    result.h / result.ny
  );

  if (parameters.nums && cellSize >= 28) {
    const fontSize = Math.max(10, Math.round(cellSize * 0.24));

    context.font = `bold ${fontSize}px Arial, sans-serif`;
    context.textAlign = "center";
    context.textBaseline = "middle";
    context.lineJoin = "round";
    context.lineWidth = Math.max(2, fontSize / 5);

    for (let row = 0; row < result.ny; row++) {
      for (let column = 0; column < result.nx; column++) {
        const x =
          (result.xs[column] + result.xs[column + 1]) / 2;

        const y =
          (result.ys[row] + result.ys[row + 1]) / 2;

        const text = String(
          result.level[row * result.nx + column]
        );

        context.strokeStyle = "#000";
        context.strokeText(text, x, y);

        context.fillStyle = "#fff";
        context.fillText(text, x, y);
      }
    }
  }
}

function otsu(image) {
  const histogram = new Array(256).fill(0);
  const pixels = image.width * image.height;

  for (let pixel = 0; pixel < pixels; pixel++) {
    const offset = pixel * 4;

    const gray = Math.round(
      0.299 * image.data[offset] +
      0.587 * image.data[offset + 1] +
      0.114 * image.data[offset + 2]
    );

    histogram[gray]++;
  }

  let sum = 0;

  for (let threshold = 0; threshold < 256; threshold++) {
    sum += threshold * histogram[threshold];
  }

  let backgroundSum = 0;
  let backgroundWeight = 0;
  let bestVariance = 0;
  let bestThreshold = 128;

  for (let threshold = 0; threshold < 256; threshold++) {
    backgroundWeight += histogram[threshold];

    if (!backgroundWeight) continue;

    const foregroundWeight = pixels - backgroundWeight;

    if (!foregroundWeight) break;

    backgroundSum += threshold * histogram[threshold];

    const backgroundMean = backgroundSum / backgroundWeight;
    const foregroundMean =
      (sum - backgroundSum) / foregroundWeight;

    const variance =
      backgroundWeight *
      foregroundWeight *
      (backgroundMean - foregroundMean) ** 2;

    if (variance > bestVariance) {
      bestVariance = variance;
      bestThreshold = threshold;
    }
  }

  return bestThreshold;
}

