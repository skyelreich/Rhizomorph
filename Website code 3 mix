function lumenFromC(temperature) {
  const config = CONFIG.tempToLumen;

  const fraction = Math.min(
    1,
    Math.max(
      0,
      (temperature - config.coldT) /
      (config.hotT - config.coldT)
    )
  );

  return Math.round(
    config.lumenMax -
    fraction * (config.lumenMax - config.lumenMin)
  );
}

function ledFromLumen(lumen) {
  const config = CONFIG.tempToLumen;
  const colors = CONFIG.ledColors;

  const fraction = Math.min(
    1,
    Math.max(
      0,
      (lumen - config.lumenMin) /
      (config.lumenMax - config.lumenMin)
    )
  );

  const warmth = 1 - fraction;

  function mix(a, b, amount) {
    return a.map((value, index) => {
      return Math.round(value + (b[index] - value) * amount);
    });
  }

  const rgb = warmth <= 0.5
    ? mix(colors.cool, colors.neutral, warmth / 0.5)
    : mix(colors.neutral, colors.warm, (warmth - 0.5) / 0.5);

  const [r, g, b] = rgb;

  const hex = "#" + rgb.map(value => {
    return value.toString(16).padStart(2, "0");
  }).join("").toUpperCase();

  return { r, g, b, hex };
}

function lightLevel(name) {
  return Object.prototype.hasOwnProperty.call(
    CONFIG.lightLevels,
    name
  ) ? CONFIG.lightLevels[name] : "";
}

