<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mycelium Grid & Tactile Model</title>

<style>
  :root {
    color-scheme: dark;
    --bg: #060e0c;
    --panel: rgba(10, 22, 19, .92);
    --field: #050d0b;
    --ink: #e8f4ee;
    --muted: #9bbdae;
    --line: rgba(77, 232, 180, .26);
    --line-strong: rgba(77, 232, 180, .6);
    --accent: #4de8b4;
    --gold: #d4ae5a;
    --warn: #ffb454;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  body {
    margin: 0;
    color: var(--ink);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    background:
      radial-gradient(
        1200px 700px at 85% -10%,
        rgba(77, 232, 180, .08),
        transparent 60%
      ),
      radial-gradient(
        900px 600px at -10% 100%,
        rgba(212, 174, 90, .07),
        transparent 60%
      ),
      var(--bg);
  }

  #bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  main {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: auto;
    padding: 30px 18px 70px;
  }

  .hero {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .hero svg {
    flex: none;
    width: 92px;
    height: 92px;
  }

  h1 {
    margin: 0;
    font: 700 28px/1.2 var(--mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  h1 span {
    color: var(--accent);
  }

  .sub {
    margin: 8px 0 0;
    max-width: 760px;
    color: var(--muted);
  }

  section {
    position: relative;
    margin: 20px 0;
    padding: 22px;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(5px);
    border-radius: 3px;
  }

  section::before,
  section::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid var(--accent);
    pointer-events: none;
  }

  section::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }

  section::after {
    right: -1px;
    bottom: -1px;
    border-top: 0;
    border-left: 0;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    color: var(--accent);
    font: 700 15px/1.3 var(--mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h2::before {
    content: "";
    width: 14px;
    height: 14px;
    flex: none;
    background: var(--gold);
    clip-path: polygon(
      50% 0, 100% 25%, 100% 75%,
      50% 100%, 0 75%, 0 25%
    );
  }

  h2 em {
    color: var(--gold);
    font-style: normal;
  }

  .grp {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 24px 0 12px;
    color: var(--gold);
    font: 13px/1.3 var(--mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .grp::after {
    content: "";
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, var(--line), transparent);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px 18px;
  }

  .fld {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--muted);
    font-size: 14px;
  }

  .fld > span {
    color: var(--ink);
  }

  .fld small,
  .note {
    color: var(--muted);
    font-size: 13px;
  }

  .note {
    margin: 10px 0 0;
  }

  .warn {
    color: var(--warn);
  }

  input[type="text"],
  input[type="number"],
  select {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--field);
    color: var(--ink);
    font: inherit;
  }

  input::placeholder {
    color: #5f7d70;
  }

  input:focus,
  select:focus,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }

  input[type="checkbox"] {
    width: 17px;
    height: 17px;
    accent-color: var(--accent);
  }

  .inline-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
  }

  button {
    padding: 11px 15px;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    font: 600 14px/1.2 var(--mono);
    cursor: pointer;
  }

  button:hover {
    background: rgba(77, 232, 180, .1);
  }

  button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #04120d;
  }

  button.primary:hover {
    box-shadow: 0 0 18px rgba(77, 232, 180, .3);
  }

  button:disabled {
    opacity: .4;
    cursor: default;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 15px;
  }

  .drop {
    padding: 26px;
    text-align: center;
    color: var(--muted);
    border: 1px dashed var(--line-strong);
    background: repeating-linear-gradient(
      135deg,
      transparent 0 14px,
      rgba(77, 232, 180, .035) 14px 15px
    );
  }

  .drop.over {
    border-color: var(--gold);
    background-color: rgba(212, 174, 90, .08);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    padding: 9px 8px;
    color: var(--muted);
    text-align: left;
    font: 12px/1.4 var(--mono);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  td {
    padding: 8px;
    border-top: 1px solid var(--line);
  }

  tr.sel td {
    background: rgba(77, 232, 180, .1);
  }

  td.name {
    cursor: pointer;
    word-break: break-all;
  }

  td input {
    max-width: 110px;
  }

  td button {
    padding: 6px 9px;
    font-size: 12px;
  }

  #imgPanel {
    margin-top: 18px;
    padding: 15px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--gold);
    background: rgba(212, 174, 90, .04);
  }

  #imgPanel h3 {
    margin: 0;
    color: var(--gold);
    font: 700 14px/1.4 var(--mono);
    word-break: break-all;
  }

  .previews {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-bottom: 8px;
    color: var(--muted);
    font: 13px/1.3 var(--mono);
    text-transform: uppercase;
  }

  canvas.pv {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
    border: 1px solid var(--line);
  }

  .progress {
    height: 6px;
    margin-top: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, .08);
  }

  .progress > div {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--gold));
  }

  .results a {
    display: block;
    padding: 4px 0;
    color: var(--accent);
    word-break: break-all;
    font-size: 14px;
  }

  .model-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(250px, 1fr);
    gap: 18px;
    margin-top: 18px;
  }

  #canvas3d {
    height: 440px;
    position: relative;
    border: 1px solid var(--line);
    background: var(--field);
    touch-action: none;
  }

  #canvas3d canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .model-cameras {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  #grid2d {
    display: grid;
    gap: 4px;
    max-height: 340px;
    overflow: auto;
    margin-top: 12px;
  }

  .pin-cell {
    min-width: 0;
    padding: 8px 2px;
    font-size: 12px;
    line-height: 1.5;
  }

  .pin-cell small {
    display: block;
    color: var(--muted);
  }

  .scroll-table {
    max-height: 300px;
    overflow: auto;
    margin-top: 16px;
  }

  .scroll-table th {
    position: sticky;
    top: 0;
    background: var(--bg);
  }

  pre {
    max-height: 300px;
    overflow: auto;
    padding: 15px;
    border: 1px solid var(--line);
    background: var(--field);
    color: var(--ink);
    font: 12px/1.6 var(--mono);
  }

  #frameRange {
    margin-top: 15px;
  }

  #modelStatus {
    min-height: 24px;
    color: var(--gold);
  }

  @media (max-width: 760px) {
    .hero {
      align-items: flex-start;
    }

    .hero svg {
      width: 60px;
      height: 60px;
    }

    h1 {
      font-size: 23px;
    }

    .previews,
    .model-layout {
      grid-template-columns: 1fr;
    }

    #canvas3d {
      height: 340px;
    }

    section {
      padding: 17px;
    }
  }
</style>
</head>

<body>
<canvas id="bg" aria-hidden="true"></canvas>

<main>
  <header class="hero">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <g fill="none" stroke="#d4ae5a" stroke-width="1.2">
        <circle cx="50" cy="50" r="15"/>
        <circle cx="63" cy="42.5" r="15"/>
        <circle cx="63" cy="57.5" r="15"/>
        <circle cx="50" cy="65" r="15"/>
        <circle cx="37" cy="57.5" r="15"/>
        <circle cx="37" cy="42.5" r="15"/>
        <circle cx="50" cy="35" r="15"/>
      </g>
      <g fill="none" stroke="#4de8b4" stroke-width="1.6">
        <path d="M50 50 C58 44 64 40 74 30 M66 38 C70 40 76 40 82 36"/>
        <path d="M50 50 C44 58 38 66 30 76 M36 68 C32 66 26 66 20 70"/>
      </g>
    </svg>

    <div>
      <h1>Mycelium <span>Grid</span> Tool</h1>
      <p class="sub">
        Turn timelapse images into measured grid data and a moving
        tactile pin model. Image processing runs locally in your browser.
      </p>
    </div>
  </header>

  <section>
    <h2><em>01</em> Add your images</h2>

    <div class="drop" id="drop">
      Drag images here, or
      <button id="pickFiles" type="button">Choose files</button>
      <button id="pickFolder" type="button">Choose a folder</button>
      <p class="note">
        PNG or JPG recommended. Export TIFF images from Fiji as PNG.
      </p>
    </div>

    <input
      type="file"
      id="fileInput"
      accept="image/*"
      multiple
      hidden
    >

    <input
      type="file"
      id="folderInput"
      webkitdirectory
      multiple
      hidden
    >

    <div id="listWrap" hidden style="margin-top:16px">
      <table>
        <thead>
          <tr>
            <th>Image — click to select</th>
            <th>Time (h)</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="list"></tbody>
      </table>

      <p class="note">
        Filenames such as t019h provide the time automatically.
        Otherwise the file order is used. You can edit each time.
      </p>

      <div id="imgPanel">
        <h3 id="imgPanelTitle"></h3>
        <p class="note">
          Conditions for this image. Blank fields use the shared values.
        </p>
        <div id="imgFields"></div>
      </div>

      <div class="actions">
        <button id="clearAll" type="button">Clear all images</button>
      </div>
    </div>
  </section>

  <section>
    <h2><em>02</em> Experiment details &amp; conditions</h2>

    <p class="note">
      Every field is optional. Shared values are written into each CSV row.
    </p>

    <div class="grp">Microscope</div>

    <div class="fields">
      <label class="fld">
        <span>Microscope magnification</span>
        <input id="mag" type="text" placeholder="e.g. 40×">
      </label>
    </div>

    <div id="sharedFields"></div>
  </section>

  <section>
    <h2><em>03</em> Grid &amp; colonization levels</h2>

    <div class="fields">
      <label class="fld">
        <span>Grid columns</span>
        <input id="cols" type="number" min="1" max="40" step="1">
      </label>

      <label class="fld">
        <span>Grid rows</span>
        <input id="rows" type="number" min="1" max="40" step="1">
      </label>

      <label class="fld">
        <span>Hyphae are</span>
        <select id="mode">
          <option value="light">lighter than the background</option>
          <option value="dark">darker than the background</option>
        </select>
      </label>

      <label class="fld">
        <span>Threshold (0–255)</span>
        <div class="inline-row">
          <input
            id="threshRange"
            type="range"
            min="0"
            max="255"
            value="128"
          >
          <input
            id="thresh"
            type="number"
            min="0"
            max="255"
            value="128"
            style="width:85px"
          >
        </div>
      </label>
    </div>

    <div class="actions">
      <button id="auto" type="button">Auto threshold</button>
    </div>

    <div class="grp">Colonization rate cut-offs</div>

    <div class="fields">
      <label class="fld">
        <span>Rate 5 starts at (%)</span>
        <input id="c1" type="number" min="0" max="100" step="0.5">
      </label>

      <label class="fld">
        <span>Rate 10 starts at (%)</span>
        <input id="c2" type="number" min="0" max="100" step="0.5">
      </label>

      <label class="fld">
        <span>Rate 15 starts at (%)</span>
        <input id="c3" type="number" min="0" max="100" step="0.5">
      </label>

      <label class="fld">
        <span>Rate 20 starts at (%)</span>
        <input id="c4" type="number" min="0" max="100" step="0.5">
      </label>
    </div>

    <p class="note" id="levelNote"></p>

    <div class="grp">Output pictures</div>

    <div class="fields">
      <label class="check">
        <input id="showGrid" type="checkbox" checked>
        Draw grid lines
      </label>

      <label class="check">
        <input id="showOn" type="checkbox" checked>
        Tint colonized cells
      </label>

      <label class="check">
        <input id="showNums" type="checkbox" checked>
        Write the rate in each cell
      </label>
    </div>

    <p class="note">
      Grid lines, tint and numbers are added after measurement.
    </p>

    <div class="grp">Preview</div>

    <div class="previews">
      <figure>
        <figcaption>Original</figcaption>
        <canvas class="pv" id="cvOrig" width="10" height="10"></canvas>
      </figure>

      <figure>
        <figcaption>Black &amp; white + grid</figcaption>
        <canvas class="pv" id="cvOut" width="10" height="10"></canvas>
      </figure>
    </div>

    <p class="note" id="previewInfo">
      Add an image to see a preview.
    </p>
  </section>

  <section>
    <h2><em>04</em> Make the files</h2>

    <button class="primary" id="run" type="button" disabled>
      Process all images
    </button>

    <div class="progress">
      <div id="barFill"></div>
    </div>

    <p class="note" id="status" role="status"></p>

    <div class="results" id="results"></div>

    <div class="actions" id="dlActions" hidden>
      <button class="primary" id="dlZip" type="button">
        Download everything (ZIP)
      </button>

      <button id="dlCsv" type="button">
        Download grid_points CSV only
      </button>
    </div>
  </section>

  <section id="modelPanel">
    <h2><em>05</em> Tactile growth model</h2>

    <p class="note">
      Each image cell drives one pin. Target heights are 0%, 50% or 100%.
      Movement between target positions is smooth.
    </p>

    <div class="fields">
      <label class="fld">
        <span>50% height starts at coverage (%)</span>
        <input
          id="heightMid"
          type="number"
          min="0"
          max="100"
          step="0.5"
          value="25"
        >
      </label>

      <label class="fld">
        <span>100% height starts at coverage (%)</span>
        <input
          id="heightFull"
          type="number"
          min="0"
          max="100"
          step="0.5"
          value="75"
        >
      </label>

      <label class="fld">
        <span>Travel at 100% (mm)</span>
        <input
          id="travelMm"
          type="number"
          min="1"
          max="100"
          value="20"
        >
      </label>

      <label class="fld">
        <span>Playback interval (seconds / image)</span>
        <input
          id="frameSeconds"
          type="number"
          min="1"
          max="60"
          value="4"
        >
      </label>
    </div>

    <p class="note" id="mappingNote"></p>

    <div class="actions">
      <button id="playFrames" disabled>Play image sequence</button>
      <button id="resetPins">Reset pins</button>
      <button id="restoreFrame" disabled>Restore image heights</button>
    </div>

    <div class="fields" style="margin-top:15px">
      <label class="fld">
        <span>Processed image</span>
        <select id="frameSelect" disabled>
          <option>Process images to load the sequence</option>
        </select>
      </label>
    </div>

    <input
      id="frameRange"
      type="range"
      min="0"
      max="0"
      value="0"
      aria-label="Processed image frame"
      disabled
    >

    <p id="modelStatus" role="status">
      Add images to preview the model.
    </p>

    <div class="model-layout">
      <div>
        <div id="canvas3d" aria-label="3D tactile pin model"></div>

        <div class="model-cameras">
          <button id="camIso">Iso view</button>
          <button id="camTop">Top view</button>
          <button id="camSide">Side view</button>
        </div>

        <p class="note">
          Drag to rotate · scroll to zoom.
          Row 1 corresponds to the top of the source image.
        </p>
      </div>

      <div>
        <div class="grp">Pin targets</div>
        <div id="grid2d"></div>
        <p class="note" id="pinSummary"></p>

        <p class="note">
          Click a cell to cycle its target through 0%, 50% and 100%.
        </p>

        <div class="grp">Demo presets</div>

        <div class="actions">
          <button data-demo="0">T0 / Sparse</button>
          <button data-demo="1">T1 / Spreading</button>
          <button data-demo="2">T2 / Dense</button>
        </div>

        <p class="note">
          Presets are illustrative. Restore image heights to use measurements.
        </p>
      </div>
    </div>

    <div class="grp">Servo mapping</div>

    <div class="fields">
      <label class="fld">
        <span>PWM count at 0°</span>
        <input
          id="inputMinPulse"
          type="number"
          min="1"
          max="4095"
          value="150"
        >
      </label>

      <label class="fld">
        <span>PWM count at 180°</span>
        <input
          id="inputMaxPulse"
          type="number"
          min="1"
          max="4095"
          value="600"
        >
      </label>

      <label class="fld">
        <span>Servo angle at 0% height</span>
        <input
          id="inputMinAngle"
          type="number"
          min="0"
          max="180"
          value="30"
        >
      </label>

      <label class="fld">
        <span>Servo angle at 100% height</span>
        <input
          id="inputMaxAngle"
          type="number"
          min="0"
          max="180"
          value="150"
        >
      </label>
    </div>

    <p class="note">
      Angle and PWM values use a linear calibration estimate at 50 Hz.
      Calibrate your mechanism before hardware use.
      Playback controls the on-screen model.
    </p>

    <div class="scroll-table">
      <table>
        <thead>
          <tr>
            <th>Pin / cell</th>
            <th>Coverage</th>
            <th>Target</th>
            <th>Travel</th>
            <th>Board / channel</th>
            <th>Angle</th>
            <th>PWM count</th>
          </tr>
        </thead>
        <tbody id="telemetryTableBody"></tbody>
      </table>
    </div>

    <div class="actions">
      <button id="downloadHeights" disabled>Download height CSV</button>
      <button id="downloadSequence" disabled>Download sequence JSON</button>
      <button id="copyMatrix">Copy Arduino matrix</button>
    </div>

    <pre id="cppOutput"></pre>
  </section>
</main>

<datalist id="dl_sunPos">
  <option value="Morning (east)">
  <option value="Midday (overhead)">
  <option value="Afternoon (west)">
  <option value="Evening (low west)">
  <option value="No direct sun">
</datalist>

<datalist id="dl_nutrients">
  <option value="Standard">
  <option value="Enriched">
  <option value="Low">
  <option value="Depleted">
</datalist>

<datalist id="dl_substrate">
  <option value="Agar">
  <option value="Malt extract agar">
  <option value="Potato dextrose agar">
  <option value="Grain">
  <option value="Sawdust">
</datalist>

<datalist id="dl_water">
  <option value="Dry">
  <option value="Moist">
  <option value="Saturated">
  <option value="Misted daily">
</datalist>

<datalist id="dl_oxygen">
  <option value="Sealed dish">
  <option value="Vented lid">
  <option value="Open air">
  <option value="Fresh air exchange">
</datalist>

<datalist id="dl_surfaceStructure">
  <option value="Flat">
  <option value="Ridged">
  <option value="Porous">
  <option value="Textured">
</datalist>

<datalist id="dl_surfaceOrientation">
  <option value="Horizontal">
  <option value="Vertical">
  <option value="Tilted">
  <option value="Inverted">
</datalist>

<datalist id="dl_stress">
  <option value="None">
  <option value="Mild">
  <option value="Incremental: step 1">
