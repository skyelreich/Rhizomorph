<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mycelium — Living Traces</title>

<style>
:root {
  --bg: #07130f;
  --panel: #0b1b15;
  --field: #06100c;
  --mint: #4de8b4;
  --gold: #d4ae5a;
  --text: #e8f4ee;
  --muted: #9bbdae;
  --line: #275c49;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 15% 0%, #17392a 0, transparent 42%),
    var(--bg);
  font-family: "Courier New", monospace;
  line-height: 1.5;
}

main {
  max-width: 1500px;
  margin: auto;
  padding: 30px 24px 70px;
}

header {
  padding: 24px 0 32px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 28px;
}

h1 {
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.1;
  letter-spacing: 3px;
  margin: 10px 0 16px;
}

h2 {
  color: var(--gold);
  margin: 0 0 22px;
  letter-spacing: 2px;
  font-size: 22px;
}

h3 {
  color: var(--gold);
  font-size: 15px;
  letter-spacing: 1px;
  margin: 24px 0 12px;
}

p {
  margin: 8px 0;
}

small,
.note {
  color: var(--muted);
}

.kicker {
  color: var(--mint);
  letter-spacing: 3px;
  font-size: 12px;
}

section {
  position: relative;
  background: rgba(11, 27, 21, .94);
  border: 1px solid var(--line);
  padding: 26px;
  margin: 24px 0;
}

section::before {
  content: "";
  position: absolute;
  left: -1px;
  top: -1px;
  width: 18px;
  height: 18px;
  border-left: 2px solid var(--gold);
  border-top: 2px solid var(--gold);
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 16px;
}

.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

label {
  display: block;
  font-size: 13px;
  color: var(--muted);
}

label span {
  display: block;
  margin-bottom: 6px;
}

input,
select,
textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: var(--field);
  color: var(--text);
  padding: 10px;
  border-radius: 3px;
  font: inherit;
}

textarea {
  min-height: 75px;
  resize: vertical;
}

input[type="checkbox"] {
  width: auto;
  accent-color: var(--mint);
}

button {
  color: var(--text);
  background: transparent;
  border: 1px solid #389e79;
  border-radius: 3px;
  padding: 11px 15px;
  cursor: pointer;
  font: bold 13px "Courier New", monospace;
}

button:hover {
  background: #163b2b;
}

button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

button.primary {
  color: var(--bg);
  background: var(--mint);
}

button.active {
  border-color: var(--gold);
  color: var(--gold);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
}

.drop {
  border: 1px dashed var(--mint);
  padding: 30px 18px;
  text-align: center;
  color: var(--muted);
  margin-bottom: 16px;
}

.drop.over {
  background: #143d2a;
}

.preview {
  width: 100%;
  display: block;
  background: var(--field);
  border: 1px solid var(--line);
}

figure {
  margin: 0;
}

figcaption {
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 13px;
}

.scroll {
  overflow: auto;
  max-height: 330px;
  margin-top: 16px;
}

table {
  border-collapse: collapse;
  width: 100%;
  min-width: 650px;
  font-size: 12px;
}

th,
td {
  border: 1px solid var(--line);
  padding: 9px;
  text-align: left;
}

th {
  color: var(--gold);
  background: var(--field);
  position: sticky;
  top: 0;
}

td input {
  min-width: 90px;
  padding: 6px;
}

.progress {
  height: 6px;
  background: #183427;
  margin: 16px 0 10px;
}

.progress div {
  background: linear-gradient(90deg, var(--mint), var(--gold));
  height: 100%;
  width: 0;
}

.status {
  color: var(--gold);
  min-height: 24px;
  margin: 10px 0;
}

.model-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(260px, 1fr);
  gap: 22px;
}

#canvas3d {
  width: 100%;
  height: 560px;
  background: #050d0b;
  border: 1px solid var(--line);
  position: relative;
  overflow: hidden;
  touch-action: none;
}

#canvas3d canvas {
  width: 100%;
  height: 100%;
  display: block;
}

#pinGrid {
  display: grid;
  gap: 5px;
  max-height: 350px;
  overflow: auto;
}

.pin {
  padding: 11px 3px;
  min-width: 0;
  font-size: 13px;
}

.pin small {
  display: block;
}

.pin[data-level="50"] {
  background: #174834;
}

.pin[data-level="100"] {
  color: #f7df9c;
  background: #544520;
  border-color: var(--gold);
}

pre {
  background: var(--field);
  border: 1px solid var(--line);
  padding: 16px;
  max-height: 300px;
  overflow: auto;
  font-size: 12px;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin: 10px 0;
  font-size: 12px;
  color: var(--muted);
}

.legend b {
  color: var(--mint);
}

.full {
  grid-column: 1 / -1;
}

footer {
  color: var(--muted);
  font-size: 12px;
  padding-top: 18px;
}

@media (max-width: 850px) {
  .two,
  .model-layout {
    grid-template-columns: 1fr;
  }

  #canvas3d {
    height: 440px;
  }

  main {
    padding: 16px 12px 40px;
  }

  section {
    padding: 18px;
  }
}
</style>
</head>

<body>
<main>

<header>
  <div class="kicker">BIO UNIT 1 · MICROBIAL TRANSLATORS</div>
  <h1>MYCELIUM<br>LIVING TRACES</h1>
  <p>
    Translate mycelium images into a tactile moving landscape.
  </p>
  <p class="note">
    Image → coverage grid → 0 / 50 / 100% → kinetic model.
  </p>
</header>

<section>
  <h2>01 / IMAGE INPUT</h2>

  <div class="drop" id="dropZone">
    Drop image files here, or select files below.
  </div>

  <div class="two">
    <label>
      <span>Select images</span>
      <input id="fileInput" type="file" accept="image/*" multiple>
    </label>

    <label>
      <span>Select a folder</span>
      <input
        id="folderInput"
        type="file"
        accept="image/*"
        webkitdirectory
        multiple
      >
    </label>
  </div>

  <h3>EXPERIMENT DETAILS</h3>

  <div class="grid">
    <label>
      <span>Experiment ID</span>
      <input id="experiment" value="MYCELIUM-01">
    </label>

    <label>
      <span>Organism / strain</span>
      <input id="organism" placeholder="Species or strain">
    </label>

    <label>
      <span>Medium / substrate</span>
      <input id="medium" placeholder="PDA, MEA, wood...">
    </label>

    <label>
      <span>Magnification</span>
      <input id="magnification" placeholder="e.g. 10x">
    </label>

    <label>
      <span>Temperature / °C</span>
      <input id="temperature" type="number" step="0.1">
    </label>

    <label>
      <span>Light condition</span>
      <select id="light">
        <option value="">Not recorded</option>
        <option>Direct sunlight</option>
        <option>Partial sunlight</option>
        <option>Overcast</option>
        <option>Shade</option>
        <option>Dark</option>
      </select>
    </label>

    <label>
      <span>Light intensity / lux</span>
      <input id="lux" type="number" min="0">
    </label>

    <label>
      <span>Nutrients</span>
      <input id="nutrients">
    </label>

    <label>
      <span>Water / moisture</span>
      <input id="water">
    </label>

    <label>
      <span>Oxygen / aeration</span>
      <input id="oxygen">
    </label>

    <label>
      <span>Surface structure</span>
      <input id="surface">
    </label>

    <label>
      <span>Orientation / stress</span>
      <input id="orientation">
    </label>

    <label class="full">
      <span>Notes</span>
      <textarea id="notes"></textarea>
    </label>
  </div>

  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Time / h</th>
          <th>Temperature override</th>
          <th>Lux override</th>
          <th>Notes override</th>
        </tr>
      </thead>
      <tbody id="fileRows"></tbody>
    </table>
  </div>

  <div class="actions">
    <button id="clearFiles">Clear images</button>
  </div>

  <p class="note">
    Times can be edited. Names such as t019h are read as 19 hours.
    Blank overrides use the shared experiment details.
  </p>
</section>

<section>
  <h2>02 / IMAGE ANALYSIS</h2>

  <div class="grid">
    <label>
      <span>Grid columns</span>
      <input id="cols" type="number" min="1" max="40" value="4">
    </label>

    <label>
      <span>Grid rows</span>
      <input id="rows" type="number" min="1" max="40" value="4">
    </label>

    <label>
      <span>Threshold method</span>
      <select id="thresholdMode">
        <option value="otsu">Automatic / Otsu</option>
        <option value="manual">Manual</option>
      </select>
    </label>

    <label>
      <span>Manual threshold / 0–255</span>
      <input
        id="threshold"
        type="number"
        min="0"
        max="255"
        value="140"
      >
    </label>

    <label>
      <span>Mycelium appearance</span>
      <select id="polarity">
        <option value="light">Light mycelium / dark background</option>
        <option value="dark">Dark mycelium / light background</option>
      </select>
    </label>

    <label>
      <span>Analysis maximum image size / px</span>
      <input
        id="maxSize"
        type="number"
        min="100"
        max="8000"
        value="1600"
      >
    </label>
  </div>

  <h3>ORIGINAL FIVE-LEVEL ANALYSIS</h3>

  <div class="grid">
    <label>
      <span>Level 5 starts at coverage / %</span>
      <input id="rate1" type="number" value="5" min="0" max="100">
    </label>

    <label>
      <span>Level 10 starts at coverage / %</span>
      <input id="rate2" type="number" value="25" min="0" max="100">
    </label>

    <label>
      <span>Level 15 starts at coverage / %</span>
      <input id="rate3" type="number" value="50" min="0" max="100">
    </label>

    <label>
      <span>Level 20 starts at coverage / %</span>
      <input id="rate4" type="number" value="75" min="0" max="100">
    </label>
  </div>

  <div class="actions">
    <button class="primary" id="process">Analyse all images</button>
  </div>

  <div class="progress">
    <div id="progressBar"></div>
  </div>

  <p class="status" id="analysisStatus">No images loaded.</p>

  <div class="two">
    <figure>
      <figcaption>Original image</figcaption>
      <canvas class="preview" id="originalCanvas"></canvas>
    </figure>

    <figure>
      <figcaption>Binary mask and coverage grid</figcaption>
      <canvas class="preview" id="maskCanvas"></canvas>
    </figure>
  </div>

  <div class="actions">
    <button id="downloadPNG">Download current mask PNG</button>
    <button id="downloadAnalysis">Download analysis CSV</button>
    <button id="downloadFirst">Download first appearance CSV</button>
    <button id="downloadSettings">Download settings JSON</button>
    <button id="downloadZIP">Download all as ZIP</button>
  </div>

  <p class="note">
    Coverage is the fraction of segmented pixels in each grid cell.
    The segmentation must be checked against the original image.
  </p>
</section>

<section>
  <h2>03 / IMAGE → HEIGHT</h2>

  <div class="grid">
    <label>
      <span>50% height starts at coverage / %</span>
      <input
        id="middleThreshold"
        type="number"
        min="0"
        max="100"
        value="25"
      >
    </label>

    <label>
      <span>100% height starts at coverage / %</span>
      <input
        id="fullThreshold"
        type="number"
        min="0"
        max="100"
        value="75"
      >
    </label>

    <label>
      <span>Physical travel / mm</span>
      <input id="travel" type="number" min="1" max="200" value="20">
    </label>

    <label>
      <span>Image sequence interval / seconds</span>
      <input
        id="frameSeconds"
        type="number"
        min="0.5"
        step="0.5"
        value="4"
      >
    </label>
  </div>

  <p id="mappingNote" class="note"></p>

  <h3>PROCESSED IMAGE SEQUENCE</h3>

  <select id="frameSelect">
    <option>No processed images</option>
  </select>

  <input
    id="frameRange"
    type="range"
    min="0"
    max="0"
    value="0"
    style="margin-top:14px"
  >

  <div class="actions">
    <button id="previousFrame">Previous image</button>
    <button id="playFrames">Play image sequence</button>
    <button id="nextFrame">Next image</button>
    <button id="restoreImage">Restore image targets</button>
  </div>

  <div class="actions">
    <button id="downloadHeights">Download height CSV</button>
    <button id="downloadSequence">Download sequence JSON</button>
    <button id="copyMatrix">Copy Arduino matrix</button>
  </div>
</section>

<section>
  <h2>04 / KINETIC PILLAR MODEL</h2>

  <p class="note">
    Taller pillars and amplified visual travel make height differences
    easier to see. Physical measurements and exported targets are unchanged.
  </p>

  <h3>MOVEMENT SETTINGS</h3>

  <div class="grid">
    <label>
      <span>Movement mode</span>
      <select id="motionMode">
        <option value="static">Image target heights</option>
        <option value="wave">Continuous mycelium wave</option>
      </select>
    </label>

    <label>
      <span>Wave period / seconds</span>
      <input id="wavePeriod" type="number" min="2" max="120" value="8">
    </label>

    <label>
      <span>Delay between columns / seconds</span>
      <input
        id="columnDelay"
        type="number"
        min="0"
        max="30"
        step="0.1"
        value="1"
      >
    </label>

    <label>
      <span>Visual travel multiplier</span>
      <input
        id="visualScale"
        type="number"
        min="0.5"
        max="5"
        step="0.5"
        value="2"
      >
    </label>
  </div>

  <p class="status" id="modelStatus">Model ready.</p>

  <div class="model-layout">
    <div>
      <div id="canvas3d"></div>

      <div class="actions">
        <button data-view="iso">Isometric view</button>
        <button data-view="top">Top view</button>
        <button data-view="side">Side view</button>
        <button id="pauseMotion">Pause motion</button>
      </div>

      <p class="note">
        Drag to rotate. Scroll to zoom.
      </p>
    </div>

    <div>
      <h3 style="margin-top:0">PIN TARGETS</h3>

      <div id="pinGrid"></div>

      <p id="pinSummary" class="note"></p>

      <div class="legend">
        <span><b>0%</b> minimum</span>
        <span><b>50%</b> half range</span>
        <span><b>100%</b> full range</span>
      </div>

      <h3>DEMONSTRATION PRESETS</h3>

      <div class="actions">
        <button data-preset="0">T0 / Sparse</button>
        <button data-preset="1">T1 / Spreading</button>
        <button data-preset="2">T2 / Dense</button>
        <button id="resetPins">All 0%</button>
      </div>

      <p class="note">
        Click a pin button to cycle its target:
        0% → 50% → 100% → 0%.
      </p>

      <p class="note">
        In wave mode the image controls maximum amplitude.
        Each column moves with a time delay.
      </p>
    </div>
  </div>

  <h3>ARDUINO EXPORT CALIBRATION</h3>

  <div class="grid">
    <label>
      <span>Angle at minimum height / degrees</span>
      <input id="minAngle" type="number" min="0" max="180" value="30">
    </label>

    <label>
      <span>Angle at maximum height / degrees</span>
      <input id="maxAngle" type="number" min="0" max="180" value="150">
    </label>

    <label>
      <span>PWM count at 0 degrees</span>
      <input id="minPWM" type="number" min="0" max="4095" value="150">
    </label>

    <label>
      <span>PWM count at 180 degrees</span>
      <input id="maxPWM" type="number" min="0" max="4095" value="600">
    </label>
  </div>

  <p class="note">
    These are configurable estimates. Calibrate the actual servo linkage.
    PCA9685 PWM counts are not microseconds.
  </p>

  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Pin / row / column</th>
          <th>Image coverage</th>
          <th>Maximum target</th>
          <th>Target travel</th>
          <th>PCA9685 / channel</th>
          <th>Target angle</th>
          <th>PWM count</th>
        </tr>
      </thead>
      <tbody id="telemetry"></tbody>
    </table>
  </div>

  <h3>ARDUINO TARGET MATRICES</h3>
  <pre id="arduinoOutput"></pre>
</section>

<footer>
  Mycelium-driven tactile landscape · Browser simulation.
  A height field is a translation of image coverage, not a reconstruction
  of the true three-dimensional fungal network.
</footer>

</main>

<!-- External libraries: internet connection required for these features. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
"use strict";

// ============================================================
// DOM AND APPLICATION STATE
// ============================================================

const $ = id => document.getElementById(id);

const metadataIds = [
  "experiment",
  "organism",
  "medium",
  "magnification",
  "temperature",
  "light",
  "lux",
  "nutrients",
  "water",
  "oxygen",
  "surface",
  "orientation",
  "notes"
];

const analysisIds = [
  "cols",
  "rows",
  "thresholdMode",
  "threshold",
  "polarity",
  "maxSize",
  "rate1",
  "rate2",
  "rate3",
  "rate4"
];

let images = [];
let frames = [];
let activeFrame = -1;
let analysisRevision = 0;
let processedRevision = -1;
let processing = false;

let gridCols = 4;
let gridRows = 4;

let targetHeights = [];
let displayHeights = [];
let activeCoverage = [];

let sequenceTimer = null;
let motionPaused = false;
let animationClock = 0;
let lastAnimationTime = null;

let scene = null;
let camera = null;
let renderer = null;
let pinGroup = null;

let pins = [];
let rods = [];

let currentView = "iso";
let cameraYaw = Math.PI / 4;
let cameraPitch = 0.72;
let cameraDistance = 440;
let cameraTargetY = 20;

let fallbackCanvas = null;
let fallbackZoom = 1;

const PIN_LENGTH = 120;
const PIN_BASE_CENTER = 6;
const PIN_RADIUS = 6;
const PIN_SPACING = 40;

const TWO_PI = Math.PI * 2;

// ============================================================
// GENERAL UTILITIES
// ============================================================

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function numeric(id, min, max) {
  const value = Number($(id).value);

  if (!Number.isFinite(value) || value < min || value > max) {
    throw new Error(
      `${id}: enter a value between ${min} and ${max}.`
    );
  }

  return value;
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

function csvCell(value) {
  const text = value === undefined || value === null
    ? ""
    : String(value);

  return /[",\n\r]/.test(text)
    ? '"' + text.replace(/"/g, '""') + '"'
    : text;
}

function csvText(rows) {
  return rows.map(row => row.map(csvCell).join(",")).join("\r\n");
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement("a");

  anchor.href = url;
  anchor.download = filename;
  document.body.appendChild(anchor);
  anchor.click();
  anchor.remove();

  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function downloadText(text, filename, type = "text/plain") {
  downloadBlob(new Blob([text], { type }), filename);
}

function safeName(filename) {
  return filename.replace(/\.[^.]+$/, "").replace(/[^\w.-]+/g, "_");
}

function canvasBlob(canvas) {
  return new Promise((resolve, reject) => {
    canvas.toBlob(blob => {
      if (blob) resolve(blob);
      else reject(new Error("Could not create PNG."));
    }, "image/png");
  });
}

function yieldToBrowser() {
  return new Promise(resolve => setTimeout(resolve, 0));
}

function showError(error) {
  $("analysisStatus").textContent = error.message || String(error);
}

function setModelStatus(text) {
  $("modelStatus").textContent = text;
}

function stopSequence() {
  if (sequenceTimer !== null) {
    clearInterval(sequenceTimer);
    sequenceTimer = null;
  }

  $("playFrames").textContent = "Play image sequence";
}

function markAnalysisChanged() {
  analysisRevision++;
  stopSequence();

  if (frames.length) {
    $("analysisStatus").textContent =
      "Inputs changed. Analyse again before exporting image results.";
  }
}

function requireFreshFrames() {
  if (!frames.length) {
    throw new Error("Analyse images first.");
  }

  if (processedRevision !== analysisRevision) {
    throw new Error("Inputs changed. Please analyse the images again.");
  }
}

function metadataFor(item) {
  const metadata = {};

  for (const id of metadataIds) {
    metadata[id] = $(id).value.trim();
  }

  for (const id of ["temperature", "lux", "notes"]) {
    const override = item.overrides[id];

    if (override !== "") {
      metadata[id] = override;
    }
  }

  return metadata;
}

// ============================================================
// IMAGE INPUT
// ============================================================

function inferTime(filename, fallback) {
  const match = filename.match(/(?:^|[_\s-])t(\d+(?:\.\d+)?)h/i)
    || filename.match(/t(\d+(?:\.\d+)?)h/i);

  return match ? Number(match[1]) : fallback;
}

function addFiles(fileList) {
  const added = Array.from(fileList).filter(file =>
    file.type.startsWith("image/") ||
    /\.(png|jpe?g|webp|bmp|gif|tiff?)$/i.test(file.name)
  );

  for (const file of added) {
    images.push({
      file,
      time: inferTime(file.name, images.length),
      overrides: {
        temperature: "",
        lux: "",
        notes: ""
      }
    });
  }

  if (added.length) {
    markAnalysisChanged();
    renderFileRows();

    $("analysisStatus").textContent =
      `${images.length} image(s) loaded. Ready to analyse.`;
  }
}

function renderFileRows() {
  const body = $("fileRows");
  body.replaceChildren();

  images.forEach((item, index) => {
    const row = document.createElement("tr");

    const nameCell = document.createElement("td");
    nameCell.textContent = item.file.name;
    row.appendChild(nameCell);

    const timeCell = document.createElement("td");
    const timeInput = document.createElement("input");

    timeInput.type = "number";
    timeInput.step = "0.1";
    timeInput.value = item.time;

    timeInput.onchange = () => {
      item.time = Number(timeInput.value);
      markAnalysisChanged();
    };

    timeCell.appendChild(timeInput);
    row.appendChild(timeCell);

    for (const key of ["temperature", "lux", "notes"]) {
      const cell = document.createElement("td");
      const input = document.createElement("input");

      input.type = key === "notes" ? "text" : "number";

      if (key === "temperature") {
        input.step = "0.1";
      }

      if (key === "lux") {
        input.min = "0";
      }

      input.value = item.overrides[key];
      input.setAttribute("aria-label", `${item.file.name}: ${key}`);

      input.onchange = () => {
        item.overrides[key] = input.value.trim();
        markAnalysisChanged();
      };

      cell.appendChild(input);
      row.appendChild(cell);
    }

    body.appendChild(row);
  });
}

