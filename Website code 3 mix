// ============================================================
// IMAGE SEGMENTATION
// ============================================================

function readAnalysisSettings() {
  const cols = numeric("cols", 1, 40);
  const rows = numeric("rows", 1, 40);

  if (!Number.isInteger(cols) || !Number.isInteger(rows)) {
    throw new Error("Grid rows and columns must be whole numbers.");
  }

  const cuts = [
    numeric("rate1", 0, 100),
    numeric("rate2", 0, 100),
    numeric("rate3", 0, 100),
    numeric("rate4", 0, 100)
  ];

  for (let i = 1; i < cuts.length; i++) {
    if (cuts[i] < cuts[i - 1]) {
      throw new Error("Five-level coverage thresholds must increase.");
    }
  }

  return {
    cols,
    rows,
    thresholdMode: $("thresholdMode").value,
    threshold: numeric("threshold", 0, 255),
    polarity: $("polarity").value,
    maxSize: numeric("maxSize", 100, 8000),
    cuts
  };
}

async function loadImageCanvas(file, maxSize) {
  const url = URL.createObjectURL(file);

  try {
    const image = new Image();

    await new Promise((resolve, reject) => {
      image.onload = resolve;
      image.onerror = () => reject(
        new Error(`Cannot read image: ${file.name}`)
      );
      image.src = url;
    });

    const factor = Math.min(
      1,
      maxSize / Math.max(image.naturalWidth, image.naturalHeight)
    );

    const canvas = document.createElement("canvas");

    canvas.width = Math.max(
      1,
      Math.round(image.naturalWidth * factor)
    );

    canvas.height = Math.max(
      1,
      Math.round(image.naturalHeight * factor)
    );

    const context = canvas.getContext("2d", {
      willReadFrequently: true
    });

    context.fillStyle = "#000";
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.drawImage(image, 0, 0, canvas.width, canvas.height);

    return canvas;
  } finally {
    URL.revokeObjectURL(url);
  }
}

function otsuThreshold(histogram, pixelCount) {
  let weightedSum = 0;

  for (let value = 0; value < 256; value++) {
    weightedSum += value * histogram[value];
  }

  let backgroundCount = 0;
  let backgroundSum = 0;
  let bestVariance = -1;
  let bestThreshold = 127;

  for (let value = 0; value < 256; value++) {
    backgroundCount += histogram[value];

    if (!backgroundCount) continue;

    const foregroundCount = pixelCount - backgroundCount;

    if (!foregroundCount) break;

    backgroundSum += value * histogram[value];

    const backgroundMean = backgroundSum / backgroundCount;
    const foregroundMean =
      (weightedSum - backgroundSum) / foregroundCount;

    const variance =
      backgroundCount *
      foregroundCount *
      Math.pow(backgroundMean - foregroundMean, 2);

    if (variance > bestVariance) {
      bestVariance = variance;
      bestThreshold = value;
    }
  }

  return bestThreshold;
}

function rateFromCoverage(fraction, cuts) {
  const percent = fraction * 100;

  if (percent < cuts[0]) return 0;
  if (percent < cuts[1]) return 5;
  if (percent < cuts[2]) return 10;
  if (percent < cuts[3]) return 15;

  return 20;
}

async function analyseImage(item, settings, sourceIndex) {
  const source = await loadImageCanvas(
    item.file,
    settings.maxSize
  );

  const width = source.width;
  const height = source.height;

  if (settings.cols > width || settings.rows > height) {
    throw new Error(
      `${item.file.name}: grid exceeds the image dimensions.`
    );
  }

  const sourceContext = source.getContext("2d", {
    willReadFrequently: true
  });

  const data = sourceContext.getImageData(
    0, 0, width, height
  );

  const grey = new Uint8Array(width * height);
  const histogram = new Uint32Array(256);

  for (let i = 0; i < grey.length; i++) {
    const offset = i * 4;

    const value = Math.round(
      data.data[offset] * 0.2126 +
      data.data[offset + 1] * 0.7152 +
      data.data[offset + 2] * 0.0722
    );

    grey[i] = value;
    histogram[value]++;
  }

  const threshold = settings.thresholdMode === "otsu"
    ? otsuThreshold(histogram, grey.length)
    : settings.threshold;

  const binary = new Uint8Array(grey.length);

  const mask = document.createElement("canvas");
  mask.width = width;
  mask.height = height;

  const maskContext = mask.getContext("2d");
  const maskData = maskContext.createImageData(width, height);

  for (let i = 0; i < grey.length; i++) {
    const selected = settings.polarity === "light"
      ? grey[i] > threshold
      : grey[i] <= threshold;

    binary[i] = selected ? 1 : 0;

    const offset = i * 4;
    const value = selected ? 255 : 0;

    maskData.data[offset] = value;
    maskData.data[offset + 1] = value;
    maskData.data[offset + 2] = value;
    maskData.data[offset + 3] = 255;
  }

  maskContext.putImageData(maskData, 0, 0);

  const coverage = [];
  const rates = [];

  for (let row = 0; row < settings.rows; row++) {
    const y0 = Math.floor(row * height / settings.rows);
    const y1 = Math.floor((row + 1) * height / settings.rows);

    for (let col = 0; col < settings.cols; col++) {
      const x0 = Math.floor(col * width / settings.cols);
      const x1 = Math.floor((col + 1) * width / settings.cols);

      let selectedCount = 0;

      for (let y = y0; y < y1; y++) {
        for (let x = x0; x < x1; x++) {
          selectedCount += binary[y * width + x];
        }
      }

      const fraction =
        selectedCount / ((x1 - x0) * (y1 - y0));

      coverage.push(fraction);
      rates.push(rateFromCoverage(fraction, settings.cuts));
    }
  }

  // The overlay is added after measuring the raw mask.
  maskContext.textAlign = "center";
  maskContext.textBaseline = "middle";

  for (let row = 0; row < settings.rows; row++) {
    for (let col = 0; col < settings.cols; col++) {
      const i = row * settings.cols + col;

      const x0 = Math.floor(col * width / settings.cols);
      const x1 = Math.floor((col + 1) * width / settings.cols);
      const y0 = Math.floor(row * height / settings.rows);
      const y1 = Math.floor((row + 1) * height / settings.rows);

      maskContext.fillStyle =
        `rgba(212,174,90,${coverage[i] * 0.35})`;

      maskContext.fillRect(x0, y0, x1 - x0, y1 - y0);

      maskContext.strokeStyle = "#4de8b4";
      maskContext.lineWidth = Math.max(1, width / 1000);

      maskContext.strokeRect(
        x0, y0, x1 - x0, y1 - y0
      );

      const cellWidth = x1 - x0;
      const cellHeight = y1 - y0;

      if (cellWidth >= 35 && cellHeight >= 22) {
        const fontSize = clamp(
          Math.min(cellWidth / 5, cellHeight / 4),
          9,
          24
        );

        maskContext.font = `bold ${fontSize}px monospace`;
        maskContext.lineWidth = 3;
        maskContext.strokeStyle = "#000";
        maskContext.fillStyle = "#fff";

        const text = `${(coverage[i] * 100).toFixed(0)}%`;
        const x = (x0 + x1) / 2;
        const y = (y0 + y1) / 2;

        maskContext.strokeText(text, x, y);
        maskContext.fillText(text, x, y);
      }
    }
  }

  const frame = {
    filename: item.file.name,
    sourceIndex,
    time: item.time,
    cols: settings.cols,
    rows: settings.rows,
    width,
    height,
    threshold,
    coverage,
    rates,
    metadata: metadataFor(item),
    originalPNG: await canvasBlob(source),
    maskPNG: await canvasBlob(mask)
  };

  return frame;
}

$("process").onclick = async () => {
  if (processing) return;

  try {
    if (!images.length) {
      throw new Error("Select at least one image first.");
    }

    for (const item of images) {
      if (!Number.isFinite(item.time)) {
        throw new Error("Every image needs a valid time.");
      }
    }

    const settings = readAnalysisSettings();
    const revision = analysisRevision;
    const ordered = images
      .map((item, index) => ({ item, index }))
      .sort((a, b) => a.item.time - b.item.time);

    processing = true;
    $("process").disabled = true;
    stopSequence();

    const nextFrames = [];

    for (let i = 0; i < ordered.length; i++) {
      $("analysisStatus").textContent =
        `Analysing ${i + 1} / ${ordered.length}: ` +
        ordered[i].item.file.name;

      await yieldToBrowser();

      const frame = await analyseImage(
        ordered[i].item,
        settings,
        ordered[i].index
      );

      if (analysisRevision !== revision) {
        throw new Error(
          "Inputs changed during processing. Analyse again."
        );
      }

      nextFrames.push(frame);

      $("progressBar").style.width =
        `${(i + 1) / ordered.length * 100}%`;
    }

    if (analysisRevision !== revision) {
      throw new Error("Inputs changed. Analyse again.");
    }

    frames = nextFrames;
    processedRevision = revision;

    resetGrid(settings.cols, settings.rows);
    renderFrameControls();
    applyFrame(0);

    $("analysisStatus").textContent =
      `Completed ${frames.length} image(s). ` +
      "Targets have been sent to the model.";
  } catch (error) {
    showError(error);
  } finally {
    processing = false;
    $("process").disabled = false;
  }
};

// ============================================================
// HEIGHT MAPPING AND IMAGE PLAYBACK
// ============================================================

function heightMappingSettings() {
  const middle = numeric("middleThreshold", 0, 100);
  const full = numeric("fullThreshold", 0, 100);

  if (middle >= full) {
    throw new Error(
      "The 50% threshold must be lower than the 100% threshold."
    );
  }

  return { middle, full };
}

function heightForCoverage(fraction, mapping) {
  const value = fraction * 100;

  if (value < mapping.middle) return 0;
  if (value < mapping.full) return 0.5;

  return 1;
}

function updateMappingNote() {
  try {
    const mapping = heightMappingSettings();

    $("mappingNote").textContent =
      `Coverage below ${mapping.middle}% → height 0%; ` +
      `${mapping.middle}% to below ${mapping.full}% → height 50%; ` +
      `${mapping.full}% and above → height 100%.`;
  } catch (error) {
    $("mappingNote").textContent = error.message;
  }
}

function renderFrameControls() {
  const select = $("frameSelect");
  select.replaceChildren();

  if (!frames.length) {
    select.add(new Option("No processed images", ""));
    $("frameRange").max = 0;
    $("frameRange").value = 0;
    return;
  }

  frames.forEach((frame, index) => {
    select.add(new Option(
      `${index + 1}. ${frame.filename} · ${frame.time} h`,
      index
    ));
  });

  $("frameRange").max = frames.length - 1;
}

let previewRevision = 0;

async function drawPreview(frame) {
  const revision = ++previewRevision;

  async function draw(blob, canvasId) {
    const url = URL.createObjectURL(blob);

    try {
      const image = new Image();

      await new Promise((resolve, reject) => {
        image.onload = resolve;
        image.onerror = reject;
        image.src = url;
      });

      if (revision !== previewRevision) return;

      const canvas = $(canvasId);
      canvas.width = image.naturalWidth;
      canvas.height = image.naturalHeight;

      canvas.getContext("2d").drawImage(image, 0, 0);
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  try {
    await Promise.all([
      draw(frame.originalPNG, "originalCanvas"),
      draw(frame.maskPNG, "maskCanvas")
    ]);
  } catch {
    setModelStatus("Could not display image preview.");
  }
}

function applyFrame(index) {
  requireFreshFrames();

  const mapping = heightMappingSettings();

  index = clamp(Number(index), 0, frames.length - 1);

  const frame = frames[index];

  if (gridCols !== frame.cols || gridRows !== frame.rows) {
    resetGrid(frame.cols, frame.rows);
  }

  activeFrame = index;
  activeCoverage = frame.coverage.slice();

  targetHeights = frame.coverage.map(value =>
    heightForCoverage(value, mapping)
  );

  $("frameSelect").value = index;
  $("frameRange").value = index;

  drawPreview(frame);
  updateTelemetry();

  setModelStatus(
    `Image targets: ${frame.filename} · ${frame.time} h`
  );
}

function safelyApplyFrame(index) {
  try {
    applyFrame(index);
  } catch (error) {
    setModelStatus(error.message);
    stopSequence();
  }
}

$("frameSelect").onchange = () => {
  stopSequence();
  safelyApplyFrame($("frameSelect").value);
};

$("frameRange").oninput = () => {
  stopSequence();
  safelyApplyFrame($("frameRange").value);
};

$("previousFrame").onclick = () => {
  stopSequence();

  if (frames.length) {
    safelyApplyFrame(
      (activeFrame - 1 + frames.length) % frames.length
    );
  }
};

$("nextFrame").onclick = () => {
  stopSequence();

  if (frames.length) {
    safelyApplyFrame((activeFrame + 1) % frames.length);
  }
};

$("restoreImage").onclick = () => {
  stopSequence();

  if (activeFrame >= 0) {
    safelyApplyFrame(activeFrame);
  } else {
    setModelStatus("Analyse an image first.");
  }
};

$("playFrames").onclick = () => {
  if (sequenceTimer !== null) {
    stopSequence();
    return;
  }

  try {
    requireFreshFrames();

    const interval = numeric("frameSeconds", 0.5, 3600) * 1000;

    if (activeFrame < 0) {
      applyFrame(0);
    }

    $("playFrames").textContent = "Stop image sequence";

    sequenceTimer = setInterval(() => {
      safelyApplyFrame((activeFrame + 1) % frames.length);
    }, interval);
  } catch (error) {
    setModelStatus(error.message);
  }
};

$("frameSeconds").onchange = stopSequence;

for (const id of ["middleThreshold", "fullThreshold"]) {
  $(id).oninput = () => {
    stopSequence();
    updateMappingNote();

    if (activeFrame >= 0) {
      safelyApplyFrame(activeFrame);
    }
  };
}

// ============================================================
// GRID, TELEMETRY AND ARDUINO MATRICES
// ============================================================

function resetGrid(cols, rows) {
  gridCols = cols;
  gridRows = rows;

  const count = cols * rows;

  targetHeights = Array(count).fill(0);
  displayHeights = Array(count).fill(0);

  const grid = $("pinGrid");
  grid.style.gridTemplateColumns =
    `repeat(${cols}, minmax(38px, 1fr))`;

  grid.replaceChildren();

  for (let i = 0; i < count; i++) {
    const button = document.createElement("button");

    button.className = "pin";
    button.id = `pin-${i}`;

    button.onclick = () => {
      stopSequence();

      targetHeights[i] =
        (targetHeights[i] + 0.5) % 1.5;

      updateTelemetry();

      setModelStatus(
        `Manual target: pin ${i + 1} = ` +
        `${targetHeights[i] * 100}%`
      );
    };

    grid.appendChild(button);
  }

  build3DModel();
  updateTelemetry();
}

function calibration() {
  return {
    minAngle: numeric("minAngle", 0, 180),
    maxAngle: numeric("maxAngle", 0, 180),
    minPWM: numeric("minPWM", 0, 4095),
    maxPWM: numeric("maxPWM", 0, 4095)
  };
}

function matrixText(name, values, type = "uint8_t") {
  const lines = [];

  for (let row = 0; row < gridRows; row++) {
    const valuesInRow = values.slice(
      row * gridCols,
      (row + 1) * gridCols
    );

    lines.push(
      "  {" + valuesInRow.join(", ") + "}"
    );
  }

  return (
    `const ${type} ${name}[${gridRows}][${gridCols}] = {\n` +
    lines.join(",\n") +
    "\n};"
  );
}

function updateTelemetry() {
  let cal;
  let travel;

  try {
    cal = calibration();
    travel = numeric("travel", 1, 200);
  } catch (error) {
    setModelStatus(error.message);
    return;
  }

  const counts = { 0: 0, 50: 0, 100: 0 };
  const percentages = [];
  const angles = [];
  const tableRows = [];

  targetHeights.forEach((height, index) => {
    const percent = Math.round(height * 100);

    percentages.push(percent);
    counts[percent]++;

    const angle = Math.round(
      cal.minAngle +
      (cal.maxAngle - cal.minAngle) * height
    );

    angles.push(angle);

    const pwm = Math.round(
      cal.minPWM +
      (cal.maxPWM - cal.minPWM) * angle / 180
    );

    const row = Math.floor(index / gridCols);
    const col = index % gridCols;

    const board = 0x40 + Math.floor(index / 16);
    const channel = index % 16;

    const button = $(`pin-${index}`);

    if (button) {
      button.dataset.level = percent;
      button.innerHTML =
        `<small>#${index + 1}</small>${percent}%`;
    }

    const coverage = activeCoverage[index] === undefined
      ? "—"
      : (activeCoverage[index] * 100).toFixed(1) + "%";

    tableRows.push(
      "<tr>" +
      `<td>#${index + 1} / R${row + 1} C${col + 1}</td>` +
      `<td>${coverage}</td>` +
      `<td>${percent}%</td>` +
      `<td>${(height * travel).toFixed(1)} mm</td>` +
      `<td>0x${board.toString(16)} / ${channel}</td>` +
      `<td>${angle}°</td>` +
      `<td>${pwm}</td>` +
      "</tr>"
    );
  });

  $("telemetry").innerHTML = tableRows.join("");

  $("pinSummary").textContent =
    `${gridCols} × ${gridRows} · ${targetHeights.length} pins · ` +
    `0%: ${counts[0]} · 50%: ${counts[50]} · 100%: ${counts[100]}`;

  $("arduinoOutput").textContent =
    "// Row-major image targets.\n" +
    "// Calibrate the physical servo linkage before use.\n\n" +
    matrixText("imageHeightPercent", percentages) +
    "\n\n" +
    matrixText("servoAngles", angles) +
    "\n\n" +
    "// PCA9685 frequency: 50 Hz\n" +
    "// Board address = 0x40 + floor(pinIndex / 16)\n" +
    "// Channel = pinIndex % 16\n" +
    "// PWM counts below are not microseconds.\n" +
    `// PWM at 0 degrees: ${cal.minPWM}\n` +
    `// PWM at 180 degrees: ${cal.maxPWM}\n`;
}

for (const id of [
  "travel",
  "minAngle",
  "maxAngle",
  "minPWM",
  "maxPWM"
]) {
  $(id).oninput = updateTelemetry;
}

$("copyMatrix").onclick = async () => {
  const text = $("arduinoOutput").textContent;

  try {
    if (!navigator.clipboard) {
      throw new Error("Clipboard unavailable.");
    }

    await navigator.clipboard.writeText(text);
    setModelStatus("Arduino matrices copied.");
  } catch {
    const textarea = document.createElement("textarea");

    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.left = "-9999px";

    document.body.appendChild(textarea);
    textarea.select();

    let copied = false;

    try {
      copied = document.execCommand("copy");
    } catch {
      copied = false;
    }

    textarea.remove();

    if (copied) {
      setModelStatus("Arduino matrices copied.");
    } else {
      const selection = window.getSelection();
      const range = document.createRange();

      range.selectNodeContents($("arduinoOutput"));
      selection.removeAllRanges();
      selection.addRange(range);

      setModelStatus(
        "Matrix selected. Press Command+C or Control+C."
      );
    }
  }
};

$("resetPins").onclick = () => {
  stopSequence();
  targetHeights.fill(0);
  updateTelemetry();
  setModelStatus("All target heights set to 0%.");
};

document.querySelectorAll("[data-preset]").forEach(button => {
  button.onclick = () => {
    stopSequence();

    const stage = Number(button.dataset.preset);

    targetHeights = targetHeights.map((_, index) => {
      const col = index % gridCols;
      const row = Math.floor(index / gridCols);

      const x = (col - (gridCols - 1) / 2) /
        Math.max(1, gridCols / 2);

      const y = (row - (gridRows - 1) / 2) /
        Math.max(1, gridRows / 2);

      const distance = Math.hypot(x, y);

      if (stage === 0) {
        return distance < 0.42 ? 0.5 : 0;
      }

      if (stage === 1) {
        return distance < 0.5
          ? 1
          : distance < 0.95 ? 0.5 : 0;
      }

      return distance < 0.95 ? 1 : 0.5;
    });

    updateTelemetry();
    setModelStatus(
      `Demonstration preset T${stage}. Restore image targets to return.`
    );
  };
});

// ============================================================
// THREE.JS MODEL
// ============================================================

function disposeGroup(group) {
  group.traverse(object => {
    if (object.geometry) {
      object.geometry.dispose();
    }

    if (object.material) {
      const materials = Array.isArray(object.material)
        ? object.material
        : [object.material];

      materials.forEach(material => material.dispose());
    }
  });
}

function build3DModel() {
  if (!scene) return;

  if (pinGroup) {
    scene.remove(pinGroup);
    disposeGroup(pinGroup);
  }

  pinGroup = new THREE.Group();
  scene.add(pinGroup);

  pins = [];
  rods = [];

  const width = (gridCols - 1) * PIN_SPACING + 80;
  const depth = (gridRows - 1) * PIN_SPACING + 80;

  for (const y of [-20, 20]) {
    const plate = new THREE.Mesh(
      new THREE.BoxGeometry(width, 5, depth),
      new THREE.MeshStandardMaterial({
        color: 0x17362b,
        transparent: true,
        opacity: 0.45,
        roughness: 0.65,
        metalness: 0.2,
        depthWrite: false
      })
    );

    plate.position.y = y;
    pinGroup.add(plate);
  }

  for (let row = 0; row < gridRows; row++) {
    for (let col = 0; col < gridCols; col++) {
      const x = (col - (gridCols - 1) / 2) * PIN_SPACING;
      const z = (row - (gridRows - 1) / 2) * PIN_SPACING;

      const pin = new THREE.Mesh(
        new THREE.CylinderGeometry(
          PIN_RADIUS,
          PIN_RADIUS,
          PIN_LENGTH,
          20
        ),
        new THREE.MeshStandardMaterial({
          color: 0xd4ae5a,
          roughness: 0.4,
          metalness: 0.3
        })
      );

      pin.position.set(x, PIN_BASE_CENTER, z);
      pinGroup.add(pin);
      pins.push(pin);

      const cap = new THREE.Mesh(
        new THREE.CylinderGeometry(
          PIN_RADIUS + 0.2,
          PIN_RADIUS + 0.2,
          2,
          20
        ),
        new THREE.MeshStandardMaterial({
          color: 0xf0c967,
          roughness: 0.35,
          metalness: 0.2
        })
      );

      cap.position.y = PIN_LENGTH / 2;
      pin.add(cap);

      const rod = new THREE.Mesh(
        new THREE.CylinderGeometry(1.5, 1.5, 30, 8),
        new THREE.MeshStandardMaterial({
          color: 0x4de8b4,
          roughness: 0.4
        })
      );

      rod.position.set(x, PIN_BASE_CENTER - 71, z);

      pinGroup.add(rod);
      rods.push(rod);
    }
  }

  cameraDistance = Math.max(width, depth) * 2.1;
  setView("iso");
}

function updateCamera() {
  if (!camera) return;

  const target = new THREE.Vector3(0, cameraTargetY, 0);

  if (currentView === "top") {
    camera.position.set(0, cameraTargetY + cameraDistance, 0.1);
  } else {
    const pitch = currentView === "side" ? 0.08 : cameraPitch;
    const horizontal = Math.cos(pitch) * cameraDistance;

    camera.position.set(
      Math.sin(cameraYaw) * horizontal,
      cameraTargetY + Math.sin(pitch) * cameraDistance,
      Math.cos(cameraYaw) * horizontal
    );
  }

  camera.lookAt(target);
}

function setView(view) {
  currentView = view;

  if (view === "iso") {
    cameraYaw = Math.PI / 4;
    cameraPitch = 0.72;
  }

  if (view === "side") {
    cameraYaw = Math.PI / 2;
  }

  updateCamera();
}

function installPointerControls(container) {
  let previous = null;

  container.addEventListener("pointerdown", event => {
    previous = { x: event.clientX, y: event.clientY };
    container.setPointerCapture(event.pointerId);
  });

  function release() {
    previous = null;
  }

  container.addEventListener("pointerup", release);
  container.addEventListener("pointercancel", release);

  container.addEventListener("pointermove", event => {
    if (!previous) return;

    const dx = event.clientX - previous.x;
    const dy = event.clientY - previous.y;

    if (currentView !== "iso") {
      currentView = "iso";
    }

    cameraYaw -= dx * 0.007;
    cameraPitch = clamp(
      cameraPitch + dy * 0.005,
      0.08,
      1.5
    );

    updateCamera();

    previous = { x: event.clientX, y: event.clientY };
  });

  container.addEventListener("wheel", event => {
    event.preventDefault();

    cameraDistance = clamp(
      cameraDistance * Math.exp(event.deltaY * 0.001),
      90,
      12000
    );

    fallbackZoom = clamp(
      fallbackZoom * Math.exp(-event.deltaY * 0.001),
      0.25,
      3
    );

    updateCamera();
  }, { passive: false });
}

function initRenderer() {
  const container = $("canvas3d");

  installPointerControls(container);

  try {
    if (!window.THREE) {
      throw new Error("Three.js unavailable.");
    }

    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x050d0b);

    camera = new THREE.PerspectiveCamera(
      45,
      1,
      0.1,
      30000
    );

    renderer = new THREE.WebGLRenderer({
      antialias: true
    });

    renderer.setPixelRatio(
      Math.min(2, window.devicePixelRatio || 1)
    );

    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.8));

    const key = new THREE.DirectionalLight(0xffffff, 1);
    key.position.set(180, 400, 160);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x4de8b4, 0.35);
    fill.position.set(-200, 100, -100);
    scene.add(fill);

    const resize = () => {
      const width = Math.max(1, container.clientWidth);
      const height = Math.max(1, container.clientHeight);

      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    new ResizeObserver(resize).observe(container);
    resize();
  } catch (error) {
    if (renderer) {
      renderer.dispose();
      renderer.domElement.remove();
    }

    renderer = null;
    scene = null;
    camera = null;

    fallbackCanvas = document.createElement("canvas");
    container.appendChild(fallbackCanvas);

    setModelStatus(
      "Compatible Canvas preview active. Analysis and exports remain available."
    );
  }
}

document.querySelectorAll("[data-view]").forEach(button => {
  button.onclick = () => setView(button.dataset.view);
});

// ============================================================
// CANVAS FALLBACK
// ============================================================

function drawFallback() {
  if (!fallbackCanvas) return;

  const width = fallbackCanvas.clientWidth;
  const height = fallbackCanvas.clientHeight;
  const dpr = Math.min(2, window.devicePixelRatio || 1);

  const pixelWidth = Math.round(width * dpr);
  const pixelHeight = Math.round(height * dpr);

  if (
    fallbackCanvas.width !== pixelWidth ||
    fallbackCanvas.height !== pixelHeight
  ) {
    fallbackCanvas.width = pixelWidth;
    fallbackCanvas.height = pixelHeight;
  }

  const context = fallbackCanvas.getContext("2d");

  context.setTransform(dpr, 0, 0, dpr, 0, 0);
  context.clearRect(0, 0, width, height);

  const scale = Math.min(
    width / ((gridCols + gridRows) * 0.85 + 2),
    height / ((gridCols + gridRows) * 0.45 + 7)
  ) * fallbackZoom;

  const angle = cameraYaw;
  const travel = Number($("travel").value) || 20;
  const visualScale = Number($("visualScale").value) || 2;

  function project(x, z, y = 0) {
    if (currentView === "top") {
      return [
        width / 2 + x * scale,
        height / 2 + z * scale
      ];
    }

    if (currentView === "side") {
      return [
        width / 2 + x * scale,
        height * 0.8 - y * scale
      ];
    }

    const rx = x * Math.cos(angle) - z * Math.sin(angle);
    const rz = x * Math.sin(angle) + z * Math.cos(angle);

    return [
      width / 2 + rx * scale,
      height * 0.70 + rz * scale * 0.5 - y * scale
    ];
  }

  const corners = [
    [-gridCols / 2 - 0.4, -gridRows / 2 - 0.4],
    [ gridCols / 2 + 0.4, -gridRows / 2 - 0.4],
    [ gridCols / 2 + 0.4,  gridRows / 2 + 0.4],
    [-gridCols / 2 - 0.4,  gridRows / 2 + 0.4]
  ];

  context.beginPath();

  corners.forEach(([x, z], index) => {
    const point = project(x, z);

    if (index === 0) context.moveTo(...point);
    else context.lineTo(...point);
  });

  context.closePath();
  context.fillStyle = "#102b22";
  context.fill();
  context.strokeStyle = "#3c725a";
  context.stroke();

  const sortedPins = displayHeights.map((value, index) => ({
    value,
    index,
    x: index % gridCols - (gridCols - 1) / 2,
    z: Math.floor(index / gridCols) - (gridRows - 1) / 2
  }));

  sortedPins.sort((a, b) =>
    (a.x * Math.sin(angle) + a.z * Math.cos(angle)) -
    (b.x * Math.sin(angle) + b.z * Math.cos(angle))
  );

  for (const pin of sortedPins) {
    const base = project(pin.x, pin.z);

    const top = project(
      pin.x,
      pin.z,
      0.9 + pin.value * travel / 20 * visualScale
    );

    const radius = Math.max(2, scale * 0.15);

    context.lineWidth = radius * 2;
    context.strokeStyle = "#8b8242";

    if (currentView !== "top") {
      context.beginPath();
      context.moveTo(...base);
      context.lineTo(...top);
      context.stroke();
    }

    context.beginPath();

    context.ellipse(
      top[0],
      top[1],
      radius,
      currentView === "top" ? radius : radius * 0.5,
      0,
      0,
      TWO_PI
    );

    context.fillStyle = "#efc86a";
    context.fill();

    if (targetHeights.length <= 64) {
      context.fillStyle = "#e8f4ee";
      context.font = "11px monospace";
      context.textAlign = "center";
      context.fillText(pin.index + 1, top[0], top[1] - 10);
    }
  }

  context.fillStyle = "#9bbdae";
  context.font = "12px monospace";
  context.textAlign = "left";
  context.fillText("ROW 1 = IMAGE TOP", 14, 24);
}

// ============================================================
// CONTINUOUS WAVE ANIMATION
// ============================================================

$("pauseMotion").onclick = () => {
  motionPaused = !motionPaused;

  $("pauseMotion").textContent = motionPaused
    ? "Resume motion"
    : "Pause motion";
};

$("motionMode").onchange = () => {
  animationClock = 0;
};

function animate(now) {
  requestAnimationFrame(animate);

  if (lastAnimationTime === null) {
    lastAnimationTime = now;
  }

  const dt = Math.min(
    0.1,
    Math.max(0, (now - lastAnimationTime) / 1000)
  );

  lastAnimationTime = now;

  if (!motionPaused) {
    animationClock += dt;

    const mode = $("motionMode").value;
    const period = Math.max(2, Number($("wavePeriod").value) || 8);
    const columnDelay = Math.max(
      0,
      Number($("columnDelay").value) || 0
    );

    const fadeProgress = clamp(animationClock / 3, 0, 1);
    const fade =
      0.5 - 0.5 * Math.cos(Math.PI * fadeProgress);

    for (let i = 0; i < displayHeights.length; i++) {
      let desired = targetHeights[i];

      if (mode === "wave") {
        const col = i % gridCols;

        const phase = TWO_PI *
          ((animationClock % period) - col * columnDelay) /
          period;

        const wave = 0.5 - 0.5 * Math.cos(phase);

        desired *= wave * fade;
      }

      displayHeights[i] +=
        (desired - displayHeights[i]) *
        (1 - Math.exp(-dt * 5));
    }
  }

  const travel = Number($("travel").value) || 20;
  const visualScale = Number($("visualScale").value) || 2;

  for (let i = 0; i < pins.length; i++) {
    pins[i].position.y =
      PIN_BASE_CENTER +
      displayHeights[i] * travel * visualScale;

    rods[i].position.y =
      pins[i].position.y - 71;
  }

  if (renderer && scene && camera) {
    renderer.render(scene, camera);
  } else {
    drawFallback();
  }
}

// ============================================================
// DATA EXPORT
// ============================================================

function exportSettings() {
  const analysis = readAnalysisSettings();
  const mapping = heightMappingSettings();

  return {
    project: "Mycelium Living Traces",
    generatedAt: new Date().toISOString(),
    analysis,
    heightMapping: {
      middleStartsAtCoveragePercent: mapping.middle,
      fullStartsAtCoveragePercent: mapping.full,
      levels: [0, 50, 100]
    },
    physicalTravelMm: numeric("travel", 1, 200),
    imageIntervalSeconds: numeric("frameSeconds", 0.5, 3600),
    movement: {
      mode: $("motionMode").value,
      wavePeriodSeconds: Number($("wavePeriod").value),
      columnDelaySeconds: Number($("columnDelay").value)
    },
    preview: {
      pillarLength: PIN_LENGTH,
      visualTravelMultiplier: Number($("visualScale").value),
      displayOnly: true
    },
    calibration: calibration()
  };
}

function analysisCSV() {
  requireFreshFrames();

  const rows = [[
    "filename",
    "time_h",
    "row",
    "column",
    "coverage_percent",
    "analysis_level",
    "threshold",
    "analysis_width_px",
    "analysis_height_px",
    ...metadataIds
  ]];

  for (const frame of frames) {
    frame.coverage.forEach((coverage, index) => {
      rows.push([
        frame.filename,
        frame.time,
        Math.floor(index / frame.cols) + 1,
        index % frame.cols + 1,
        (coverage * 100).toFixed(4),
        frame.rates[index],
        frame.threshold,
        frame.width,
        frame.height,
        ...metadataIds.map(id => frame.metadata[id])
      ]);
    });
  }

  return csvText(rows);
}

function heightsCSV() {
  requireFreshFrames();

  const mapping = heightMappingSettings();
  const travel = numeric("travel", 1, 200);

  const rows = [[
    "filename",
    "time_h",
    "pin",
    "row",
    "column",
    "coverage_percent",
    "analysis_level",
    "height_percent",
    "target_travel_mm"
  ]];

  for (const frame of frames) {
    frame.coverage.forEach((coverage, index) => {
      const height = heightForCoverage(coverage, mapping);

      rows.push([
        frame.filename,
        frame.time,
        index + 1,
        Math.floor(index / frame.cols) + 1,
        index % frame.cols + 1,
        (coverage * 100).toFixed(4),
        frame.rates[index],
        height * 100,
        height * travel
      ]);
    });
  }

  return csvText(rows);
}

function firstAppearanceCSV() {
  requireFreshFrames();

  const rows = [[
    "pin",
    "row",
    "column",
    "first_detected_time_h",
    "filename",
    "criterion"
  ]];

  const first = frames[0];

  for (let i = 0; i < first.coverage.length; i++) {
    const frame = frames.find(item => item.rates[i] > 0);

    rows.push([
      i + 1,
      Math.floor(i / first.cols) + 1,
      i % first.cols + 1,
      frame ? frame.time : "",
      frame ? frame.filename : "",
      "first analysis level greater than 0"
    ]);
  }

  return csvText(rows);
}

function sequenceJSON() {
  requireFreshFrames();

  const mapping = heightMappingSettings();

  const data = {
    ...exportSettings(),
    rowOrder: "top to bottom",
    columnOrder: "left to right",
    frames: frames.map(frame => ({
      filename: frame.filename,
      time_h: frame.time,
      cols: frame.cols,
      rows: frame.rows,
      threshold: frame.threshold,
      coveragePercent: frame.coverage.map(value =>
        Number((value * 100).toFixed(4))
      ),
      analysisLevels: frame.rates,
      heightPercent: frame.coverage.map(value =>
        heightForCoverage(value, mapping) * 100
      ),
      metadata: frame.metadata
    }))
  };

  return JSON.stringify(data, null, 2);
}

function exportAction(action) {
  try {
    action();
  } catch (error) {
    showError(error);
  }
}

$("downloadAnalysis").onclick = () => exportAction(() => {
  downloadText(
    analysisCSV(),
    "mycelium_analysis.csv",
    "text/csv"
  );
});

$("downloadHeights").onclick = () => exportAction(() => {
  downloadText(
    heightsCSV(),
    "mycelium_pin_heights.csv",
    "text/csv"
  );
});

$("downloadFirst").onclick = () => exportAction(() => {
  downloadText(
    firstAppearanceCSV(),
    "mycelium_first_appearance.csv",
    "text/csv"
  );
});

$("downloadSequence").onclick = () => exportAction(() => {
  downloadText(
    sequenceJSON(),
    "mycelium_sequence.json",
    "application/json"
  );
});

$("downloadSettings").onclick = () => exportAction(() => {
  downloadText(
    JSON.stringify(exportSettings(), null, 2),
    "mycelium_settings.json",
    "application/json"
  );
});

$("downloadPNG").onclick = () => exportAction(() => {
  requireFreshFrames();

  const frame = frames[Math.max(0, activeFrame)];

  downloadBlob(
    frame.maskPNG,
    safeName(frame.filename) + "_mask_grid.png"
  );
});

$("downloadZIP").onclick = async () => {
  const button = $("downloadZIP");

  try {
    requireFreshFrames();

    if (!window.JSZip) {
      throw new Error(
        "ZIP library unavailable. Connect to the internet or download files individually."
      );
    }

    // Build export text synchronously from the current settings.
    const analysis = analysisCSV();
    const heights = heightsCSV();
    const first = firstAppearanceCSV();
    const sequence = sequenceJSON();

    const settings = JSON.stringify(
      exportSettings(),
      null,
      2
    );

    const snapshot = frames.slice();

    const zip = new JSZip();

    zip.file("mycelium_analysis.csv", analysis);
    zip.file("mycelium_pin_heights.csv", heights);
    zip.file("mycelium_first_appearance.csv", first);
    zip.file("mycelium_sequence.json", sequence);
    zip.file("mycelium_settings.json", settings);

    for (let i = 0; i < snapshot.length; i++) {
      const prefix = String(i + 1).padStart(3, "0");
      const frame = snapshot[i];

      zip.file(
        `masks/${prefix}_${safeName(frame.filename)}.png`,
        frame.maskPNG
      );
    }

    button.disabled = true;
    $("analysisStatus").textContent = "Preparing ZIP...";

    const blob = await zip.generateAsync({
      type: "blob",
      compression: "STORE"
    });

    downloadBlob(blob, "mycelium_export.zip");

    $("analysisStatus").textContent = "ZIP downloaded.";
  } catch (error) {
    showError(error);
  } finally {
    button.disabled = false;
  }
};

// ============================================================
// INPUT VALIDATION AND INITIALIZATION
// ============================================================

for (const id of [...metadataIds, ...analysisIds]) {
  $(id).addEventListener("input", markAnalysisChanged);
}

for (const id of ["cols", "rows"]) {
  $(id).addEventListener("change", () => {
    try {
      const cols = numeric("cols", 1, 40);
      const rows = numeric("rows", 1, 40);

      if (!Number.isInteger(cols) || !Number.isInteger(rows)) {
        throw new Error("Grid dimensions must be whole numbers.");
      }

      activeCoverage = [];
      resetGrid(cols, rows);
    } catch (error) {
      setModelStatus(error.message);
    }
  });
}

initRenderer();
resetGrid(4, 4);
updateMappingNote();
renderFrameControls();
requestAnimationFrame(animate);

