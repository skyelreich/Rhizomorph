#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include <math.h>

const int SDA_PIN = 11;  // A4
const int SCL_PIN = 12;  // A5

const uint8_t PCA_ADDRESS = 0x40;
const uint8_t SERVO_COUNT = 16;

const unsigned long UPDATE_INTERVAL_MS = 20;
const unsigned long STARTUP_HOLD_MS = 2000;

Adafruit_PWMServoDriver pwm(PCA_ADDRESS);

// Each row configures one servo.
//
// lowUs     = pulse width at one end
// highUs    = pulse width at the other end
// periodMs  = time for one complete back-and-forth cycle
// offsetMs  = position within the cycle when movement begins
//
// All pulse widths require calibration for your actual servos.
struct ServoMotion {
  uint16_t lowUs;
  uint16_t highUs;
  uint32_t periodMs;
  uint32_t offsetMs;
};

// Channel order: 0 to 15
const ServoMotion motions[SERVO_COUNT] = {
  {1300, 1700,  8000,    0},  // Channel 0
  {1400, 1600,  6000, 1000},  // Channel 1
  {1350, 1650, 10000, 2500},  // Channel 2
  {1300, 1700, 12000, 6000},  // Channel 3

  {1450, 1550,  5000, 1250},  // Channel 4
  {1350, 1650,  9000, 4500},  // Channel 5
  {1400, 1600, 14000, 3500},  // Channel 6
  {1300, 1700, 11000, 8250},  // Channel 7

  {1350, 1650,  7000, 1750},  // Channel 8
  {1450, 1550, 10000, 5000},  // Channel 9
  {1300, 1700, 15000, 3750},  // Channel 10
  {1400, 1600,  8000, 6000},  // Channel 11

  {1350, 1650, 13000, 6500},  // Channel 12
  {1400, 1600,  9000, 2250},  // Channel 13
  {1450, 1550, 12000, 9000},  // Channel 14
  {1300, 1700, 16000, 4000}   // Channel 15
};

unsigned long motionStartMs = 0;
unsigned long lastUpdateMs = 0;
bool movementStarted = false;

// Returns a smooth target pulse width for one servo.
uint16_t calculatePulse(
  const ServoMotion &motion,
  unsigned long elapsedMs
) {
  uint32_t positionMs =
    ((elapsedMs % motion.periodMs) + motion.offsetMs)
    % motion.periodMs;

  float phase =
    (2.0f * PI * positionMs) / motion.periodMs;

  float centreUs =
    (motion.lowUs + motion.highUs) / 2.0f;

  float amplitudeUs =
    (motion.highUs - motion.lowUs) / 2.0f;

  // Smoothly blend from centre during the first 3 seconds.
  float blend = elapsedMs / 3000.0f;
  if (blend > 1.0f) {
    blend = 1.0f;
  }

  float pulseUs =
    centreUs + amplitudeUs * sinf(phase) * blend;

  return (uint16_t)lroundf(pulseUs);
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  Wire.beginTransmission(PCA_ADDRESS);

  if (Wire.endTransmission() != 0) {
    while (true) {
      Serial.println(
        "PCA9685 not found. Check SDA, SCL, VCC and GND."
      );
      delay(2000);
    }
  }

  if (!pwm.begin()) {
    while (true) {
      Serial.println("PCA9685 initialization failed.");
      delay(2000);
    }
  }

  pwm.setPWMFreq(50);
  delay(10);

  // Turn off every channel before setting initial positions.
  for (uint8_t channel = 0; channel < SERVO_COUNT; channel++) {
    pwm.setPWM(channel, 0, 4096);
  }

  // Centre each servo in sequence during startup.
  // The initial movement depends on its physical position.
  for (uint8_t channel = 0; channel < SERVO_COUNT; channel++) {
    uint16_t centreUs =
      (motions[channel].lowUs + motions[channel].highUs) / 2;

    pwm.writeMicroseconds(channel, centreUs);
    delay(150);
  }

  motionStartMs = millis() + STARTUP_HOLD_MS;

  Serial.println("16 servos ready. Holding centre for 2 seconds.");
}

void loop() {
  unsigned long now = millis();

  // Wait for the startup hold to finish.
  if (!movementStarted) {
    if ((long)(now - motionStartMs) < 0) {
      return;
    }

    movementStarted = true;
    lastUpdateMs = now;
    Serial.println("16 independent servo movements started.");
  }

  if (now - lastUpdateMs < UPDATE_INTERVAL_MS) {
    return;
  }

  lastUpdateMs = now;
  unsigned long elapsedMs = now - motionStartMs;

  // Update all 16 target positions in the same cycle.
  for (uint8_t channel = 0; channel < SERVO_COUNT; channel++) {
    uint16_t pulseUs =
      calculatePulse(motions[channel], elapsedMs);

    pwm.writeMicroseconds(channel, pulseUs);
  }
}
