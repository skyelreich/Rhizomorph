#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

// Native GPIO numbers for ESP32S3 Dev Module
const int SDA_PIN = 11;  // Board label A4
const int SCL_PIN = 12;  // Board label A5

const uint8_t PCA_ADDRESS = 0x40;
const uint8_t SERVO_CHANNEL = 15;

// Small initial test range, in microseconds.
// These are pulse widths, not angles.
const int CENTER_US = 1500;
const int LOW_US = 1300;
const int HIGH_US = 1700;

Adafruit_PWMServoDriver pwm(PCA_ADDRESS);
int currentUs = CENTER_US;

void moveSlowly(int targetUs) {
  while (currentUs != targetUs) {
    currentUs += (targetUs > currentUs) ? 1 : -1;
    pwm.writeMicroseconds(SERVO_CHANNEL, currentUs);
    delay(10);
  }

  delay(1000);
}

void setup() {
  Serial.begin(115200);
  delay(2000);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  // Check that the PCA9685 responds.
  Wire.beginTransmission(PCA_ADDRESS);
  if (Wire.endTransmission() != 0) {
    while (true) {
      Serial.println("PCA9685 not found. Check wiring and power.");
      delay(2000);
    }
  }

  if (!pwm.begin()) {
    while (true) {
      Serial.println("PCA9685 initialization failed.");
      delay(2000);
    }
  }

  pwm.setPWMFreq(50);
  delay(10);

  // Disable all channels before enabling the test servo.
  for (uint8_t ch = 0; ch < 16; ch++) {
    pwm.setPWM(ch, 0, 4096);
  }

  pwm.writeMicroseconds(SERVO_CHANNEL, CENTER_US);
  delay(2000);

  Serial.println("Single servo test started.");
}

void loop() {
  Serial.println("Moving to side 1");
  moveSlowly(LOW_US);

  Serial.println("Moving to side 2");
  moveSlowly(HIGH_US);

  Serial.println("Returning to centre");
  moveSlowly(CENTER_US);
}
